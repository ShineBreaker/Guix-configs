 // If data is saved to the clipboard before the notification is sent via
 // dbus, the application freezes.
+#if defined(Q_OS_LINUX) || defined(Q_OS_UNIX)
+// flameshot exits right after copying, which kills the Qt clipboard source on
+// Wayland. Hand the data to wl-copy instead: it forks and keeps serving the
+// selection after flameshot is gone.
+static bool copyToClipboardWithWlCopy(const QPixmap& capture)
+{
+    QByteArray png;
+    QBuffer buffer(&png);
+    buffer.open(QIODevice::WriteOnly);
+    if (!capture.save(&buffer, "PNG")) {
+        return false;
+    }
+    QProcess proc;
+    proc.start(QStringLiteral("wl-copy"),
+               { QStringLiteral("--type"), QStringLiteral("image/png") });
+    if (!proc.waitForStarted(3000)) {
+        return false;
+    }
+    proc.write(png);
+    proc.closeWriteChannel();
+    if (!proc.waitForFinished(10000)) {
+        proc.kill();
+        return false;
+    }
+    return proc.exitStatus() == QProcess::NormalExit && proc.exitCode() == 0;
+}
+#endif
