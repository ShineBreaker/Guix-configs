{
  "_comment": "全局 agent 防护规则（跨所有 workspace 的通用约束，与仓库无关）。仓库专属规则（blue/guix/channel.lock/tmp/dotfiles/source 等）在各 <root>/.agents/anchors.json。代码底层（sudo 恒冻、rm 防护、git 写操作限制、~/.config·~/.local 部署位置保护）在各 hook 脚本硬编、恒定生效。本文件承载可配置的数据驱动规则，meta-frozen：agent 禁止通过 write/edit 修改它，调整须人工编辑源文件后 blue home。",
  "frozen_commands": ["sudo"],
  "frozen_paths": [],
  "frozen_globs": [],
  "interactive_commands": [
    "vi",
    "vim",
    "nvim",
    "nano",
    "pico",
    "ed",
    "less",
    "more",
    "most",
    "pg",
    "man",
    "ipython"
  ],
  "sensitive_patterns": [
    {
      "pattern": "sk-[a-zA-Z0-9]{20,}",
      "label": "疑似 API key（sk-...）",
      "flags": "i"
    },
    {
      "pattern": "(password|passwd|secret|token|api[_-]?key)\\s*[:=]\\s*[\"'][^\"'\\s]{8,}[\"']",
      "label": "明文密码/secret/token",
      "flags": "i"
    },
    {
      "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----",
      "label": "SSH 私钥"
    },
    { "pattern": "AKIA[0-9A-Z]{16}", "label": "疑似 AWS access key" },
    { "pattern": "ghp_[a-zA-Z0-9]{36}", "label": "疑似 GitHub token" }
  ],
  "redirect_conventions": {},
  "rewrite": {},
  "path_hints": {},
  "builtin_rewrite": true,
  "human_only_actions": [],
  "anchor_measurements": []
}
