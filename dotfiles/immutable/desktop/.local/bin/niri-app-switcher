#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# niri-app-switcher — niri 统一窗口切换器（rofi -dmenu）：运行中窗口按规范
# 应用名归组，菜单按历史使用排序；环境变量覆盖见 docs/scripts/misc-scripts.md §niri-app-switcher
set -euo pipefail

CONFIG="${NIRI_APP_SWITCHER_CONFIG:-$HOME/.config/niri/app-switcher.json}"
HISTORY="${NIRI_APP_SWITCHER_HISTORY:-$HOME/.cache/niri-app-switcher-history.json}"
ROFI_CONFIG="${NIRI_APP_SWITCHER_ROFI_CONFIG:-$HOME/.config/rofi/config.rasi}"
mkdir -p "$(dirname "$HISTORY")"
[ -f "$HISTORY" ] || printf '%s\n' '{}' >"$HISTORY"

# 读 JSON；缺失/损坏/空文件一律回落 {}
read_json() {
  local out
  out=$(jq -c '.' "$1" 2>/dev/null)
  [ -n "$out" ] && printf '%s\n' "$out" || printf '%s\n' '{}'
}

# tmp + mv 原子更新历史
update_history() {
  local name="$1" new_h tmp
  new_h=$(jq --arg n "$name" --argjson t "$(date +%s)" '.[$n] = $t' "$HISTORY" \
    2>/dev/null || printf '%s\n' '{}')
  tmp=$(mktemp "${HISTORY}.XXXXXX")
  printf '%s\n' "$new_h" >"$tmp"
  mv -f "$tmp" "$HISTORY"
}

# 聚焦该应用最近聚焦的窗口并记历史
dispatch_app() {
  local app_name="$1" windows win_count wid
  [ -z "$app_name" ] && exit 0

  windows=$(jq -c --arg n "$app_name" '.[$n].windows // []' <<<"$apps_state")
  win_count=$(jq 'length // 0' <<<"$windows")
  [ "$win_count" -eq 0 ] && exit 0

  # focus_timestamp 是 {secs, nanos} 对象；须拆成数组比较（直接比会先比 nanos）
  wid=$(jq -r 'max_by(.focus_timestamp // {} | [.secs // 0, .nanos // 0]).id' <<<"$windows")
  niri msg action focus-window --id "$wid" >/dev/null
  update_history "$app_name"
}

config=$(read_json "$CONFIG")
history=$(read_json "$HISTORY")

# 每条 = {key: 配置键名, ids: 认领的 app_id 列表}；
# match_app_ids 缺省或为空数组时回退为 [key]
defs=$(jq -c '
  [(.apps // {}) | to_entries[]
   | {key: .key,
      ids: ((.value.match_app_ids // [.key])
            | if length == 0 then [.key] else . end)}]
' <<<"$config" 2>/dev/null) || defs='[]'

# 同一 app_id 被多个 key 认领 → 告警但不中止
jq -r '
  map(.ids[] as $id | {id: $id, key: .key})
  | group_by(.id)
  | map(select(length > 1))
  | if length > 0
    then "warn: match_app_id collision: " + (map(.[0].id) | unique | join(", "))
    else empty
    end
' <<<"$defs" >&2

filtered_windows=$(niri msg --json windows | jq -c --argjson cfg "$config" '
  [ .[] | select(
      (.title // "") as $t
      | ($cfg.exclude_titles // []) as $bad
      | $bad | map(. as $e | $t | contains($e)) | any | not
  ) ]
')

apps_state=$(jq -cn --argjson w "$filtered_windows" --argjson defs "$defs" '
  def short_id:
    (. // "unknown" | tostring | split(".") | map(select(length > 0)) | .[-1] // "unknown" | ascii_downcase);
  ($defs | map(.ids[] as $id | {($id): .key}) | add // {}) as $rev
  | reduce $w[] as $win ({};
      ($win.app_id // "unknown") as $aid
      | ($rev[$aid] // ($aid | short_id)) as $name
      | .[$name] = ( .[$name] // { windows: [] } )
      | .[$name].windows += [ { id: $win.id,
                                focus_timestamp: $win.focus_timestamp } ] )
')

menu_lines=$(jq -rn --argjson h "$history" --argjson s "$apps_state" '
  $s | to_entries
  | sort_by( $h[.key] // 0 | tonumber? // 0 )   # 旧版历史把时间戳存成字符串
  | reverse
  | .[]
  | .key
')

[ -z "$menu_lines" ] && exit 0 # 过滤后没有窗口 → 静默退出

selected=$(printf '%s\n' "$menu_lines" \
  | rofi -dmenu \
    -config "$ROFI_CONFIG" \
    -p 'App> ' \
    -matching prefix \
    -no-custom \
    -auto-select \
    -hover-select \
    -me-select-entry '' \
    -me-accept-entry MousePrimary) || exit 0
app_name="$selected"
[ -z "$app_name" ] && exit 0
dispatch_app "$app_name"
