window-rule {
  draw-border-with-background false
  geometry-corner-radius 16
  clip-to-geometry true

  background-effect {
    blur true
    xray true
  }

  focus-ring {
    off
  }

  shadow {
    on
    softness 16
    spread 0.6
    offset x=0 y=0
    draw-behind-window false
  }
}

window-rule {
  match is-active=true is-floating=true

  background-effect {
    blur true
    xray false
  }
}

window-rule {
  match is-active=false is-floating=true

  opacity 0.62
  shadow { off; }
  background-effect {
    blur true
    xray false
  }
}

window-rule {
  match is-active=false is-floating=false

  opacity 0.62
  shadow { off; }
  background-effect {
    blur true
    xray true
  }
}

window-rule {
  match app-id="com.network.manager"
  match app-id="connman-gtk"
  match app-id="fcitx"
  match app-id="KeePassXC"
  match app-id="mpv"
  match app-id="org.gnome.FileRoller"
  match app-id="org.kde.polkit-kde-authentication-agent-1"
  match app-id="org.keepassxc.KeePassXC"
  match app-id=r#"org.quickshell$"#
  match app-id="QtScrcpy"
  match app-id="waypaper"
  match app-id="wpp"
  match app-id="wps"
  match app-id="^xdg-desktop-portal"

  open-floating true
}

window-rule {
  match app-id="^flameshot$"

  // flameshot 带 Qt::BypassWindowManagerHint，Qt 在 Wayland 下会先发
  // set_fullscreen、后发 set_app_id，niri 收到全屏请求时本规则还匹配不上，
  // 窗口直接全屏并按平铺插入新列，打开时视图跟着滚动。这里拒绝该请求，
  // 让它走浮动分支，浮窗不占布局列。
  open-floating true
  open-fullscreen false

  // 浮窗尺寸比输出逻辑尺寸各多 1 像素。分数缩放 1.75 下 Qt 的窗口 buffer 按
  // 逻辑尺寸取整（1755 * 1.75 = 3071.25 -> 3071 px），比输出少 1 物理像素，
  // 边缘会露出窗口底色。多要 1 逻辑像素后 buffer 覆盖输出，超出部分由 niri
  // 裁掉。换分辨率时需要同步调整这两个值。
  default-column-width { fixed 1756; }
  default-window-height { fixed 1098; }

  geometry-corner-radius 0
  clip-to-geometry false
  draw-border-with-background false

  focus-ring { off; }
  shadow { off; }
}

window-rule {
  match app-id="Waydroid"
  match app-id="gamescope"
  match app-id="labwc"
  match app-id="^LR2oraja"
  match app-id="r#'^steam_app'#"
  match app-id=".gamescope-wrapped"

  open-fullscreen true
}

window-rule {
  match app-id="steam"
  match title="r#'^notificationtoasts_d+_desktop$'#"

  default-floating-position relative-to="bottom-right" x=10 y=10
}

window-rule {
  match app-id="r#'^org.keepassxc.KeePassXC$'#"
  match app-id="r#'^org.gnome.World.Secrets$'#"

  block-out-from "screen-capture"
}

window-rule {
  match is-window-cast-target=true

  focus-ring {
    active-color "#7d0d2d70"
  }
  shadow {
    color "#7d0d2d70"
  }
}

workspace "Browser"
workspace "Chat"
workspace "Code"
workspace "Game"
workspace "Work"

window-rule {
  match app-id="firefox"
  match app-id="librewolf"
  match app-id="chromium-browser"
  match app-id="io.github.ungoogled_software.ungoogled_chromium"
  match app-id="^zen*"

  open-on-workspace "Browser"
  open-maximized true
}

window-rule {
  match title="r#'.*Lapce$'#"
  match app-id="code"
  match app-id="Code"
  match app-id="codium"
  match app-id="dev.zed.Zed"
  match app-id="jetbrains-pycharm"
  match app-id="jetbrains-studio"

  open-on-workspace "Code"
  open-maximized true
}

window-rule {
  match app-id="thunderbird"
  match app-id="wechat"
  match app-id="org.telegram.desktop"
  match app-id="QQ"
  match app-id="com.alibabainc.dingtalk"
  match app-id="wemeetapp"

  open-on-workspace "Chat"
}

window-rule {
  match app-id="heroic"
  match app-id="steam"
  match app-id="bms.player.beatoraja.MainLoader"
  match app-id="r#'^steam_app'#"
  match app-id="steam_app_default"
  match app-id=".gamescope-wrapped"
  match app-id="^LR2oraja"
  match app-id="net.lutris.Lutris"
  match app-id="^osu"
  match app-id="org.prismlauncher.PrismLauncher"
  match app-id="org.jackhuang.hmcl.Launcher"

  open-on-workspace "Game"
}

window-rule {
  match app-id="affinity.exe"
  match app-id="gimp"
  match app-id="krita"
  match app-id="wpsoffice"
  match app-id="^libreoffice"
  match app-id="Microsoft Windows"
  match app-id="obsidian"
  match app-id="org.kde.kdenlive"
  match app-id="org.inkscape.Inkscape"
  match app-id="resolve"

  open-on-workspace "Work"
  open-maximized true
}
