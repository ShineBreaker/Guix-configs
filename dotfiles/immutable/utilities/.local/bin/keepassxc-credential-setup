#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
# SPDX-License-Identifier: MIT
#
# keepassxc-credential-setup — 管理 git-credential-keepassxc 配置文件
#
# 用法：
#   keepassxc-credential-setup status     检查配置健康状态
#   keepassxc-credential-setup init       初始化完整配置（databases + callers）
#   keepassxc-credential-setup update     更新过期的 callers 路径
#   keepassxc-credential-setup callers    仅重新注册 callers（不影响 databases）
#
# callers 登记的是「谁被允许向 KeePassXC 要凭据」：fish（交互调用）与
# git 的 libexec/git-core/git（凭据 helper 的实际调用者）。包升级后
# store hash 变化会让已登记路径过期，status/update 负责发现它们。

set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/git-credential-keepassxc"
COMMAND="${1:-help}"

msg()  { printf ":: %s\n" "$*"; }
warn() { printf "WARNING: %s\n" "$*" >&2; }
die()  { printf "ERROR: %s\n" "$*" >&2; exit 1; }

need_cmd() {
    command -v "$1" &>/dev/null || die "需要 $1 但未找到"
}

# --- caller 路径的单一事实来源 ---

# 当前系统预期的 caller 路径（每行一个；fish 在前 git 在后）
expected_callers() {
    if command -v fish &>/dev/null; then
        readlink -f "$(command -v fish)"
    fi
    if command -v git &>/dev/null; then
        local git_real git_root git_libexec
        git_real="$(readlink -f "$(command -v git)")"
        git_root="$(dirname "$(dirname "$git_real")")"
        git_libexec="${git_root}/libexec/git-core/git"
        if [[ -e "$git_libexec" ]]; then
            echo "$git_libexec"
        else
            echo "$git_real"
        fi
    fi
}

# 配置文件里已登记的 caller 路径（每行一个）
registered_callers() {
    jq -r '.callers[].path' "$CONFIG_FILE"
}

# 体检 callers：报告「登记了但文件已消失」与「系统当前路径未登记」两类过期项。
# $1 = status（逐条报告存在性）| brief（只报问题）。
# 返回 1 = 发现过期项，0 = 全部健康。
stale_callers() {
    local style=${1:-status} i=0 issues=0 path expected
    while IFS= read -r path; do
        if [[ ! -e "$path" ]]; then
            if [[ "$style" == status ]]; then
                warn "  [$i] 路径不存在: $path"
            else
                msg "路径不存在: $path"
            fi
            issues=1
        elif [[ "$style" == status ]]; then
            msg "  [$i] 存在: $path"
        fi
        ((i++)) || true
    done < <(registered_callers)
    while IFS= read -r expected; do
        [[ -z "$expected" ]] && continue
        if ! registered_callers | grep -qxF "$expected"; then
            if [[ "$style" == status ]]; then
                warn "  当前系统路径未注册: $expected"
            else
                msg "当前系统路径未在配置中: $expected"
            fi
            issues=1
        fi
    done < <(expected_callers)
    return "$issues"
}

# 用 jq 直接重写 callers 数组（不用 caller clear/add：clear 后 bash 自身会被拦截）。
# 调用方需保证 jq 已就位（init/status 路径先经 need_cmd）。
write_callers() {
    local uid gid
    uid=$(id -u)
    gid=$(id -g)
    command -v fish &>/dev/null || warn "  fish 未找到，跳过"
    command -v git &>/dev/null || warn "  git 未找到，跳过"

    local new_callers="[]" path
    while IFS= read -r path; do
        [[ -z "$path" ]] && continue
        msg "  注册 $(basename "$path"): $path"
        new_callers=$(echo "$new_callers" | jq \
            --arg p "$path" --argjson u "$uid" --argjson g "$gid" \
            '. + [{"path": $p, "uid": $u, "gid": $g, "canonicalize": false}]')
    done < <(expected_callers)

    # 原子写入：先写临时文件再替换
    local tmp
    tmp="$(mktemp)"
    jq --argjson callers "$new_callers" '.callers = $callers' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"
}

# --- 子命令 ---

cmd_status() {
    need_cmd jq

    if [[ ! -f "$CONFIG_FILE" ]]; then
        msg "配置文件不存在: $CONFIG_FILE"
        msg "运行 'keepassxc-credential-setup init' 初始化"
        return 0
    fi

    local has_issue=0

    # 检查 databases
    local db_count
    db_count=$(jq '.databases | length' "$CONFIG_FILE")
    if [[ "$db_count" -eq 0 ]]; then
        warn "databases 为空 — 需要运行 'configure' 关联 KeePassXC"
        has_issue=1
    else
        msg "databases: ${db_count} 个已关联"
    fi

    # 检查 callers
    local caller_count
    caller_count=$(jq '.callers | length' "$CONFIG_FILE")
    if [[ "$caller_count" -eq 0 ]]; then
        warn "callers 为空"
        has_issue=1
    else
        msg "callers: ${caller_count} 个已注册"
        stale_callers status || has_issue=1
    fi

    if [[ "$has_issue" -eq 0 ]]; then
        msg "配置健康 ✓"
    else
        msg "发现问题 — 运行 'keepassxc-credential-setup update' 修复"
    fi

    return "$has_issue"
}

cmd_init() {
    need_cmd jq
    need_cmd git-credential-keepassxc

    if [[ -f "$CONFIG_FILE" ]]; then
        die "配置文件已存在: $CONFIG_FILE。如需重建请先备份后删除。"
    fi

    msg "步骤 1/2: 关联 KeePassXC 数据库..."
    git-credential-keepassxc configure --group "Git"

    msg "步骤 2/2: 注册 callers..."
    write_callers

    msg "初始化完成 ✓"
    cmd_status
}

cmd_update() {
    need_cmd jq
    need_cmd git-credential-keepassxc

    if [[ ! -f "$CONFIG_FILE" ]]; then
        die "配置文件不存在，请先运行 'keepassxc-credential-setup init'"
    fi

    # 检查是否有 databases
    local db_count
    db_count=$(jq '.databases | length' "$CONFIG_FILE")
    if [[ "$db_count" -eq 0 ]]; then
        msg "databases 为空，需要先关联 KeePassXC..."
        git-credential-keepassxc configure --group "Git"
    fi

    if stale_callers brief; then
        msg "所有 callers 路径均有效且为当前版本，无需更新"
        return 0
    fi

    msg "更新 callers..."
    write_callers

    msg "更新完成 ✓"
    cmd_status
}

cmd_callers() {
    need_cmd jq
    if [[ ! -f "$CONFIG_FILE" ]]; then
        die "配置文件不存在，请先运行 'keepassxc-credential-setup init'"
    fi

    msg "重新注册 callers..."
    write_callers

    msg "完成 ✓"
}

cmd_help() {
    cat <<EOF
keepassxc-credential-setup — 管理 git-credential-keepassxc 配置文件

用法: keepassxc-credential-setup <命令>

命令:
  status    检查配置健康状态（路径是否过期、是否与当前系统一致）
  init      初始化完整配置（databases + callers）
  update    检测并更新过期的 callers 路径
  callers   仅重新注册 callers（不影响 databases）
  help      显示此帮助信息

配置文件: $CONFIG_FILE
EOF
}

case "$COMMAND" in
    status)  cmd_status  ;;
    init)    cmd_init    ;;
    update)  cmd_update  ;;
    callers) cmd_callers ;;
    help|--help|-h) cmd_help ;;
    *) die "未知命令: $COMMAND。运行 'keepassxc-credential-setup help' 查看用法。" ;;
esac
