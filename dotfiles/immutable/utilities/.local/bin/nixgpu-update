#!/usr/bin/env bash
# nixgpu-update — 非 NixOS 主机上刷新 /var/lib/non-nixos-gpu → nix store GPU
# 资源链接（首装与 nix 重部署后各跑一次；需 root）。文档：docs/scripts/misc-scripts.md §nixgpu-update
set -euo pipefail

GPU_DIR="/var/lib/non-nixos-gpu"
TMPFILES_CONF="/etc/tmpfiles.d/non-nixos-gpu.conf"

# root 前置检查：写 /etc/ 与 /var/lib/，非 root 会在中途留下半成品
if [[ $EUID -ne 0 ]]; then
  echo "error: must run as root (writes /etc and /var/lib)" >&2
  exit 1
fi

# Guix 上 /etc/tmpfiles.d/ 默认不存在，setup 的 ln -sf 会因父目录缺失失败——
# 先 mkdir -p；setup 末步 systemd-tmpfiles --create 在 Guix 无此命令，|| true 容错
mkdir -p /etc/tmpfiles.d
non-nixos-gpu-setup || true

# conf 格式: L+ /run/opengl-driver - - - - /nix/store/<hash>-non-nixos-gpu
if [[ ! -f "$TMPFILES_CONF" ]]; then
  echo "error: $TMPFILES_CONF not found after non-nixos-gpu-setup" >&2
  exit 1
fi

target=$(awk '/^L\+ \/run\/opengl-driver/ { print $NF }' "$TMPFILES_CONF")
if [[ -z "$target" ]]; then
  echo "error: failed to parse target from $TMPFILES_CONF" >&2
  exit 1
fi
# target 来自 conf 末字段，建链前强制校验前缀，防止异常 conf 把链接指到任意路径
if [[ "$target" != /nix/store/* ]]; then
  echo "error: target is not under /nix/store: $target" >&2
  exit 1
fi

# 3) 建 /var/lib/non-nixos-gpu 链接
ln -nsf "$target" "$GPU_DIR"
echo "+ ln -nsf $target $GPU_DIR"
