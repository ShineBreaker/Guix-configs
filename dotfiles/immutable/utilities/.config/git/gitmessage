# 提交格式:
#   <type>(<scope>): <简短描述>
#   不兼容变更在 type 后加 !, 如 feat!:
#
# scope 规则:
#   - 单文件: 必须加文件名
#     feat(<文件名>): <简要描述>
#   - 多文件: 用组件的名字代替文件名
#     feat(<组件>): <简要描述>
#
# 描述规范:
#   - 第一行按照 scope 规则撰写
#     1. 动词开头, 祈使语气
#     2. 首字母小写, 末尾不加句号
#   - 空一行之后可以撰写细节，但是也不能够写的过于具体
#   - Body 解释「为什么改」
#     Footer 写 BREAKING CHANGE:
#     - <说明> 或 Closes #<issue>
#     - LLM 工作时撰写 Assisted-by 标签
#
# Assisted-by 标签
# 基本格式：
#   Assisted-by: <AGENT_NAME>:<MODEL_VERSION> [TOOL1] [TOOL2]
#
# 标签中应包含:
# - AI 代理的名称 (AGENT_NAME)
# - 模型的具体版本号 (MODEL_VERSION)，
# - 以及使用的其他辅助工具 (TOOL, 可选)。
# e.g. Assisted-by: Claude:claude-3-opus coccinelle sparse
#
# ┌───────────────────────┐
# │      类型速查表       │
# ├───────────────────────┤
# │ 核心类型:             │
# │   feat      新增功能  │
# │   fix       修复 bug  │
# ├───────────────────────┤
# │ 代码质量:             │
# │   refactor  重构代码  │
# │   perf      性能优化  │
# │   style     格式调整  │
# ├───────────────────────┤
# │ 维护类型:             │
# │   chore     杂务/清理 │
# │   build     构建系统  │
# │   ci        CI/CD     │
# ├───────────────────────┤
# │ 文档与测试:           │
# │   docs      文档更新  │
# │   test      添加测试  │
# ├───────────────────────┤
# │ 特殊类型:             │
# │   revert    回滚提交  │
# └───────────────────────┘
