set -euo pipefail

# sidebar-toggle — tmux 侧边栏 pane 生命周期与事件适配器
#
# Bash 只处理 tmux pane 生命周期。渲染、点击和折叠状态由长驻 Guile
# 进程负责；两者通过每个 sidebar pane 独有的 FIFO 通信。

scripts_dir="${HOME}/.config/tmux/scripts"
sidebar_title="tmux-sidebar"
sidebar_command="sidebar-render.scm daemon"

is_sidebar() {
    local title="$1" start="$2"
    [[ "$title" == "$sidebar_title" || "$start" == *"$sidebar_command"* ]]
}

fifo_path() {
    local pane_id="${1#%}"
    printf '/tmp/tmux-sidebar-%s-%s.fifo' "$UID" "$pane_id"
}

send_event() {
    local pane_id="$1" event="$2" fifo fd
    fifo="$(fifo_path "$pane_id")"
    [[ -p "$fifo" ]] || return 0

    # O_RDWR 打开 FIFO，即使 daemon 正在退出也不会阻塞 hook。
    exec {fd}<>"$fifo" || return 0
    printf '%s\n' "$event" >&"$fd" || true
    exec {fd}>&-
}

kill_sidebar_pane() {
    local pane_id="$1" pane_pid
    pane_pid="$(tmux display-message -p -t "$pane_id" '#{pane_pid}' 2>/dev/null || true)"
    if [[ "$pane_pid" =~ ^[0-9]+$ ]]; then
        # tmux may remove the pane without reaping an exec'd daemon.
        kill -TERM "$pane_pid" 2>/dev/null || true
    fi
    rm -f -- "$(fifo_path "$pane_id")"
    tmux kill-pane -t "$pane_id" 2>/dev/null || true
}

current_sidebar() {
    local pane_id title start
    while IFS=$'\t' read -r pane_id title start; do
        if is_sidebar "$title" "$start"; then
            printf '%s\n' "$pane_id"
            return 0
        fi
    done < <(tmux list-panes -F $'#{pane_id}\t#{pane_title}\t#{pane_start_command}' 2>/dev/null || true)
    return 1
}

signal_current() {
    local pane_id
    pane_id="$(current_sidebar || true)"
    # 末尾 || true：没有侧栏 pane 是正常的 no-op（例如 follow 尚未建好侧栏时的
    # 竞态），不应让脚本在 set -e 下以非零退出，否则 tmux run-shell 会在状态栏
    # 显示 "'...sidebar-toggle signal' returned 1"。
    [[ -n "$pane_id" ]] && send_event "$pane_id" "refresh" || true
}

kill_all_sidebars() {
    local pane_id title start
    while IFS=$'\t' read -r pane_id title start; do
        if is_sidebar "$title" "$start"; then
            kill_sidebar_pane "$pane_id"
        fi
    done < <(tmux list-panes -a -F $'#{pane_id}\t#{pane_title}\t#{pane_start_command}' 2>/dev/null || true)
}

# === 宽度管理：区分“终端窗口 resize”与“手动拖拽” ===
#
# 信号：window_width 是否变化。window\|@last 的读取必须用非 Tab 分隔
# （|）避免空的 @no_sidebar 导致 IFS-tab 的空字段丢失、字段左移错位。
# 真正 bug 曾为：@no_sidebar 为空时 IFS=$'\t' read 跳过空字段，
# 使 configured_width 误读为 window_width，导致 @w 被污染为 201 等。
#
# 策略：
# - 仅当 window 未变 且 sidebar 明显偏离 @sidebar_width 时才持久化拖拽。
# - window 已变时绝不覆盖 @sidebar_width，交由 follow 链路把侧栏拉回。
# - @sidebar_last_* 的更新由 follow 统一负责；layout-changed 仅在 window 变化
#   且未进入 resize 流程时才更新 last，避免抢跑竞态。
# - 12–80 的范围过滤用于排除窗口缩窄时的临时挤压状态。
# - 额外：client-resized 时若 window 落后于 client，需先让 window 跟 client
#   同步到 client 大小，再固定侧栏，否则放大后右侧会留虚点空白（window 尺寸
#   是大小决定因素之一，未跟上 client 时 window 仍旧 140）。

persist_sidebar_width_if_dragged() {
    local window_id sidebar_id actual_width configured_width current_win_width last_win_width
    window_id="$1"
    sidebar_id="$2"
    actual_width="$3"
    configured_width="${4:-}"
    current_win_width="${5:-}"
    last_win_width="${6:-}"

    [[ -n "$window_id" && -n "$sidebar_id" && -n "$actual_width" ]] || return 0
    [[ "$configured_width" =~ ^[0-9]+$ ]] || return 0
    [[ "$actual_width" =~ ^[0-9]+$ ]] || return 0
    [[ "$actual_width" != "$configured_width" ]] || return 0
    [[ -n "$current_win_width" && -n "$last_win_width" ]] || return 0
    [[ "$current_win_width" == "$last_win_width" ]] || return 0
    (( actual_width >= 12 && actual_width <= 80 )) || return 0

    tmux set-option -g @sidebar_width "$actual_width" 2>/dev/null || true
    if [[ -n "$current_win_width" ]]; then
        tmux set-option -g @sidebar_last_window_width "$current_win_width" 2>/dev/null || true
    fi
}

sync_window_to_client() {
    local win_w client_w
    win_w="$(tmux display-message -p '#{window_width}' 2>/dev/null)" || return 0
    # client_width 需在有 client 关联时才有值；无 client 时跳过。
    client_w="$(tmux display-message -p '#{client_width}' 2>/dev/null)" || return 0
    [[ -n "$win_w" && -n "$client_w" ]] || return 0
    [[ "$win_w" =~ ^[0-9]+$ && "$client_w" =~ ^[0-9]+$ ]] || return 0
    # 仅当放大后 window 落后于 client 时同步，避免无谓的重复 resize。
    if (( win_w < client_w )); then
        tmux resize-window -x "$client_w" 2>/dev/null || true
    fi
}

handle_layout_changed() {
    # 仅负责拖拽持久化；resize 的拉回由 follow 统一处理，避免双写入竞态。
    local context window_id configured_width current_window_width last_window_width
    context="$(tmux display-message -p '#{window_id}|#{@sidebar_width}|#{window_width}|#{@sidebar_last_window_width}' 2>/dev/null)" || {
        signal_current
        return 0
    }
    IFS='|' read -r window_id configured_width current_window_width last_window_width <<<"$context"
    [[ -n "$window_id" ]] || { signal_current; return 0; }

    if [[ -z "$last_window_width" && -n "$current_window_width" ]]; then
        tmux set-option -g @sidebar_last_window_width "$current_window_width" 2>/dev/null || true
        last_window_width="$current_window_width"
    fi

    local pane_id title start width_val sidebar_id="" sidebar_width=""
    while IFS=$'\t' read -r pane_id title start width_val; do
        if is_sidebar "$title" "$start"; then
            sidebar_id="$pane_id"
            sidebar_width="$width_val"
            break
        fi
    done < <(tmux list-panes -t "$window_id" -F $'#{pane_id}\t#{pane_title}\t#{pane_start_command}\t#{pane_width}' 2>/dev/null || true)

    if [[ -n "$sidebar_id" && -n "$sidebar_width" ]]; then
        if [[ -n "$current_window_width" && "$current_window_width" == "$last_window_width" ]]; then
            persist_sidebar_width_if_dragged "$window_id" "$sidebar_id" \
                "$sidebar_width" "$configured_width" \
                "$current_window_width" "$last_window_width"
        fi
    fi
    signal_current
}

ensure_sidebar() {
    # 关键：window\|@no_sidebar 之间用 | 分隔，避免空的 @no_sidebar 导致
    # IFS-tab 的空字段丢失、configured_width 错读为 window_width。
    local context window_id no_sidebar configured_width width socket_key lock_file
    context="$(tmux display-message -p $'#{window_id}|#{@no_sidebar}|#{@sidebar_width}|#{window_width}|#{@sidebar_last_window_width}' 2>/dev/null)" || return 0
    IFS='|' read -r window_id no_sidebar configured_width current_window_width last_window_width <<<"$context"
    [[ -n "$window_id" ]] || return 0

    if [[ -z "$last_window_width" && -n "$current_window_width" ]]; then
        tmux set-option -g @sidebar_last_window_width "$current_window_width" 2>/dev/null || true
        last_window_width="$current_window_width"
    fi

    socket_key="${TMUX%%,*}"
    socket_key="${socket_key##*/}-${window_id#@}"
    lock_file="/tmp/tmux-sidebar-${UID}-${socket_key}.lock"
    exec 9>"$lock_file"
    flock -n 9 || return 0

    local pane_id active title start
    local sidebar_id="" target_id="" fallback_id=""
    local sidebar_width="" main_width=""
    local -a duplicate_ids=()

    while IFS=$'\t' read -r pane_id active title start width_val; do
        if is_sidebar "$title" "$start"; then
            if [[ -z "$sidebar_id" ]]; then
                sidebar_id="$pane_id"
                sidebar_width="$width_val"
            else
                duplicate_ids+=("$pane_id")
            fi
            continue
        fi

        [[ -n "$fallback_id" ]] || fallback_id="$pane_id"
        if [[ "$active" == "1" ]]; then
            target_id="$pane_id"
            main_width="$width_val"
        fi
    done < <(tmux list-panes -t "$window_id" -F $'#{pane_id}\t#{pane_active}\t#{pane_title}\t#{pane_start_command}\t#{pane_width}' 2>/dev/null || true)

    for pane_id in "${duplicate_ids[@]}"; do
        kill_sidebar_pane "$pane_id"
    done

    if [[ "$no_sidebar" == "1" ]]; then
        [[ -n "$sidebar_id" ]] && kill_sidebar_pane "$sidebar_id"
        return 0
    fi

    width="${SIDEBAR_WIDTH:-$configured_width}"
    [[ "$width" =~ ^[0-9]+$ ]] || width=32

    if [[ -n "$sidebar_id" ]]; then
        # 拖拽持久化优先于拉回；window 已变时不覆盖。
        if [[ -n "$sidebar_width" && -n "$current_window_width" && "$current_window_width" == "$last_window_width" ]]; then
            persist_sidebar_width_if_dragged "$window_id" "$sidebar_id" \
                "$sidebar_width" "$configured_width" \
                "$current_window_width" "$last_window_width"
            if [[ "$sidebar_width" != "$width" ]] && (( sidebar_width >= 12 && sidebar_width <= 80 )); then
                width="$sidebar_width"
            fi
        fi
        local actual_before
        actual_before="${sidebar_width:-$(tmux display-message -p -t "$sidebar_id" '#{pane_width}' 2>/dev/null || echo "")}"
        if [[ "$actual_before" != "$width" ]]; then
            tmux resize-pane -t "$sidebar_id" -x "$width" 2>/dev/null || true
        fi
        send_event "$sidebar_id" "refresh"
        if [[ -n "$current_window_width" && "$current_window_width" =~ ^[0-9]+$ ]]; then
            tmux set-option -g @sidebar_last_window_width "$current_window_width" 2>/dev/null || true
        fi
        return 0
    fi

    target_id="${target_id:-$fallback_id}"
    if [[ -z "$target_id" ]]; then
        tmux display-message "侧边栏创建失败：当前窗口没有普通窗格"
        return 1
    fi

    local new_id
    new_id="$(tmux split-window -d -t "$target_id" -h -b -f -l "$width" -P -F '#{pane_id}' \
        "exec guile --no-auto-compile -q -s ${scripts_dir}/sidebar-render.scm daemon" 2>/dev/null)" || {
        tmux display-message "侧边栏创建失败（需要 tmux 3.3a+）"
        tmux set-option -g @sidebar_visible 0
        return 1
    }
    tmux select-pane -t "$new_id" -T "$sidebar_title" 2>/dev/null || true
    if [[ -n "$current_window_width" && "$current_window_width" =~ ^[0-9]+$ ]]; then
        tmux set-option -g @sidebar_last_window_width "$current_window_width" 2>/dev/null || true
    fi
}

case "${1:-toggle}" in
    toggle)
        # 读取走 session 级优先（-qv）：session 级未设时回退全局默认（0=纯净）。
        # 写也落在 session 级，让每个 session 独立决定侧栏开关，互不干扰。
        if [[ "$(tmux show-option -qv @sidebar_visible 2>/dev/null || echo 0)" == "1" ]]; then
            kill_all_sidebars
            tmux set-option @sidebar_visible 0
        else
            tmux set-option @sidebar_visible 1
            ensure_sidebar
        fi
        ;;
    follow)
        if [[ "$(tmux show-option -qv @sidebar_visible 2>/dev/null || echo 0)" == "1" ]]; then
            sync_window_to_client
            ensure_sidebar
        fi
        ;;
    layout-changed)
        handle_layout_changed
        ;;
    signal)
        signal_current
        ;;
    click)
        [[ $# -ge 5 ]] || exit 2
        send_event "$4" $'click\t'"$2"$'\t'"$3"$'\t'"$5"
        ;;
    toggle-group)
        pane_id="$(current_sidebar || true)"
        [[ -n "$pane_id" ]] && send_event "$pane_id" "toggle-group" || true
        ;;
    *)
        printf 'usage: sidebar-toggle [toggle|follow|signal|click|toggle-group|layout-changed]\n' >&2
        exit 2
        ;;
esac
