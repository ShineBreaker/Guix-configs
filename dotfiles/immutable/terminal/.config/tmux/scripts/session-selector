#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
set -euo pipefail

# session-selector — 统一会话选择器；设计与契约细节见 docs/scripts/session-selector.md
#
# 输出契约（stdout 单行，消费方为 conf.d/99-selector.fish）：
#   tmux|default|new|<name>   herdr|default|new|<name>   shell   __header__
#   空输出 = ESC/取消 → 留普通 shell。kind 段允许含 |（分隔符即协议符）。

# 非 tty 时颜色退化为空，便于管道测试
if [[ -t 1 ]]; then
  C_DIM=$'\033[2m'
  C_RST=$'\033[0m'
else
  C_DIM=''
  C_RST=''
fi

lines=()
has_mux=0
add() { lines+=("$1"$'\t'"$2"); }

# --- tmux 段 ---
if command -v tmux >/dev/null 2>&1; then
  has_mux=1
  add "__header__" "${C_DIM}Tmux 会话${C_RST}"

  main_status=""
  others=()
  while IFS='|' read -r name attached; do
    [[ -z "$name" ]] && continue
    # 契约：| 是输出分隔符；tmux 不禁止 | 命名，名含 | 必须过滤否则协议错位
    [[ "$name" == *"|"* || "$attached" == *"|"* ]] && continue
    if [[ "$name" == "main" ]]; then
      [[ "${attached:-0}" -gt 0 ]] && main_status="[运行中]"
    else
      others+=("$name|${attached:-0}")
    fi
  done < <(tmux list-sessions -F '#{session_name}|#{session_attached}' 2>/dev/null || true)

  msfx=""
  [[ -n "$main_status" ]] && msfx="  ${C_DIM}${main_status}${C_RST}"
  add "tmux|default" "├── 默认会话 (main)${msfx}"

  add "__header__" "${C_DIM}└── 其他会话${C_RST}"

  for entry in "${others[@]+"${others[@]}"}"; do
    name="${entry%%|*}"
    attached="${entry##*|}"
    st=""
    [[ "${attached:-0}" -gt 0 ]] && st="  ${C_DIM}[运行中]${C_RST}"
    add "tmux|$name" "    ├── $name${st}"
  done

  add "tmux|new" "    └── 新建会话"
fi

# --- herdr 段 ---
if command -v herdr >/dev/null 2>&1; then
  has_mux=1
  add "__header__" "${C_DIM}Herdr 会话${C_RST}"

  herdr_json="$(herdr session list --json 2>/dev/null || true)"

  dname="default"
  dstatus=""
  if [[ -n "$herdr_json" ]] && command -v jq >/dev/null 2>&1; then
    dinfo="$(jq -r '.sessions[] | select(.default == true) | "\(.name)\t\(.running)"' \
      <<<"$herdr_json" 2>/dev/null | head -n1 || true)"
    if [[ -n "$dinfo" ]]; then
      dname="${dinfo%%$'\t'*}"
      drun="${dinfo#*$'\t'}"
      if [[ "$drun" == "true" ]]; then
        dstatus="[运行中]"
      else
        dstatus="[已停止·可重连]"
      fi
    fi
  fi
  dsfx="  ${C_DIM}${dstatus}${C_RST}"
  add "herdr|default" "├── 默认会话 (${dname})${dsfx}"

  add "__header__" "${C_DIM}└── 其他会话${C_RST}"

  if [[ -n "$herdr_json" ]] && command -v jq >/dev/null 2>&1; then
    while IFS=$'\t' read -r name running; do
      [[ -z "$name" ]] && continue
      # 同 tmux 段：名含 | 会破坏输出协议，过滤
      [[ "$name" == *"|"* ]] && continue
      if [[ "$running" == "true" ]]; then
        st="  ${C_DIM}[运行中]${C_RST}"
      else
        st="  ${C_DIM}[已停止·可重连]${C_RST}"
      fi
      add "herdr|$name" "    ├── $name${st}"
    done < <(jq -r '.sessions[] | select(.default | not) | "\(.name)\t\(.running)"' \
      <<<"$herdr_json" 2>/dev/null || true)
  fi

  add "herdr|new" "    └── 新建会话"
fi

# --- Shell 段 ---
add "shell" "Shell (无终端复用器)"

# 无任何复用器时直接给 shell，不弹只有一项的菜单
if [[ $has_mux -eq 0 ]]; then
  echo "shell"
  exit 0
fi

# fzf 缺失按取消处理：stderr 提示 + 空 stdout（消费方留普通 shell）
if ! command -v fzf >/dev/null 2>&1; then
  echo "session-selector: fzf 未安装，无法弹出选择列表" >&2
  exit 0
fi

result="$(printf '%s\n' "${lines[@]}" \
  | fzf --reverse --no-multi \
    --header="选择会话环境" \
    --height=~60% \
    --delimiter=$'\t' \
    --with-nth=2.. \
    --ansi \
  || true)"

[[ -z "$result" ]] && exit 0

key="${result%%$'\t'*}"
echo "$key"
