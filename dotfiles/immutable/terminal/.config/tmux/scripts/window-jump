#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
set -euo pipefail

# window-jump — fzf 跨 session 窗口跳转（prefix+f）；见 docs/scripts/window-jump.md

current_session=$(tmux display -p "#{session_name}")

windows=$(tmux list-windows -a -F \
  $'#{session_name}\t#{window_index}\t#{window_name}\t#{pane_current_path}\t#{window_panes}' \
  2>/dev/null) || true

if [[ -z "$windows" ]]; then
  tmux display-message "没有可跳转的窗口"
  exit 0
fi

choices=()
while IFS=$'\t' read -r session idx name path panes; do
  pane_label="pane"
  [[ "$panes" -gt 1 ]] && pane_label="panes"
  short_path="${path%/}"
  short_path="${short_path##*/}"
  [[ -n "$short_path" ]] || short_path="/"

  if [[ "$session" == "$current_session" ]]; then
    choices+=("[当前] $name  $short_path  ($panes $pane_label)"$'\t'"$session"$'\t'"$idx")
  else
    choices+=("  $name  $short_path  ($panes $pane_label)  ← $session"$'\t'"$session"$'\t'"$idx")
  fi
done <<<"$windows"

result=$(printf '%s\n' "${choices[@]}" \
  | fzf --reverse --no-multi \
    --header="跳转到窗口" \
    --height=~50% \
    --with-nth=1 \
    --delimiter=$'\t' \
  || true)

if [[ -z "$result" ]]; then
  exit 0
fi

IFS=$'\t' read -r _ target_session target_window <<<"$result"

if [[ "$target_session" == "$current_session" ]]; then
  tmux select-window -t "$target_window"
else
  tmux switch-client -t "${target_session}:${target_window}"
fi
