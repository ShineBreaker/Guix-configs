#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
set -euo pipefail

# attach-entry — tmux 会话统一入口（attach-or-create 三步收敛）
# 用法: attach-entry <session> [-n win] [-c dir] [--create]
# 设计语义与调用链见 docs/scripts/tmux-scripts.md §attach-entry
#
# 纪律：绝不串联 tmux 命令链（分号串联有竞态闪退）；attach 恒为最后一条
# 独立命令，退出码经 exec 透传（0 = 正常 detach；≠0 = 调用方回退/重选）。

usage() {
  printf 'usage: attach-entry <session> [-n win] [-c dir] [--create]\n' >&2
  exit 2
}

ses=""
win=""
cwd=""
create=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n)
      [[ $# -ge 2 ]] || usage
      win="$2"
      shift 2
      ;;
    -c)
      [[ $# -ge 2 ]] || usage
      cwd="$2"
      shift 2
      ;;
    --create)
      create=1
      shift
      ;;
    -*)
      usage
      ;;
    *)
      [[ -z "$ses" ]] || usage
      ses="$1"
      shift
      ;;
  esac
done
[[ -n "$ses" ]] || usage

# 预检 + 按需 detached 创建：new-session 重复名退出码不可靠，须 has-session
# 预检；无 --create 且缺失时即刻非零退出，不做无谓的 set-option/follow。
if ! tmux has-session -t "$ses" 2>/dev/null; then
  if [[ $create -eq 1 ]]; then
    new_args=(-d -s "$ses")
    if [[ -n "$win" ]]; then
      new_args+=(-n "$win")
    fi
    if [[ -n "$cwd" ]]; then
      new_args+=(-c "$cwd")
    fi
    tmux new-session "${new_args[@]}"
  else
    exit 1
  fi
fi

# opt-in 侧栏 + follow；中间步骤失败不阻断 attach，由 attach 退出码决定回退
tmux set-option -t "$ses" @sidebar_visible 1 2>/dev/null || true
"${HOME}/.config/tmux/scripts/sidebar-toggle" follow >/dev/null 2>&1 || true

exec tmux attach-session -t "$ses"
