#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
lock="/tmp/custom-config-configctl-${UID}.lock"
status_file="$(mktemp /tmp/custom-configctl-status.XXXXXX)"
# set -e 下 flock/emacs 非零退出会直接终止脚本，必须靠 trap 清理状态文件
trap 'rm -f "$status_file"' EXIT
export LITERAL_CONFIGCTL_STATUS_FILE="$status_file"
printf '1' >"$status_file"

flock -x "$lock" emacs --batch -Q --script "$root/scripts/configctl.el" "$@"
emacs_status=$?
status="$(<"$status_file")"
rm -f "$status_file"

if [[ "$status" =~ ^[0-9]+$ ]]; then
    exit "$status"
fi
exit "$emacs_status"
