{
  "defaultProvider": "zai-coding-cn",
  "defaultModel": "glm-5.2",
  "npmCommand": [
    "pnpm"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "packages": [
    "npm:context-mode",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension",
    "npm:pi-hashline-edit",
    "npm:@narumitw/pi-lsp",
    "npm:pi-code-review",
    "npm:pi-gitnexus",
    "npm:@ff-labs/pi-fff",
    "npm:pi-cache-graph",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "skills": [
    "~/.config/agents/skills/*"
  ],
  "powerline": {
    "preset": "default",
    "path": {
      "mode": "abbreviated"
    }
  },
  "globalContext": {
    "enabled": true,
    "contextDir": "$XDG_CONFIG_HOME/agents/context",
    "maxFiles": 8,
    "maxBytesPerFile": 65536,
    "maxTotalBytes": 196608
  },
  "lastChangelogVersion": "0.84.1",
  "images": {
    "blockImages": false
  },
  "theme": "dark",
  "showHardwareCursor": false,
  "transport": "auto",
  "collapseChangelog": true,
  "quietStartup": true,
  "defaultThinkingLevel": "high"
}