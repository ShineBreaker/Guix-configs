# Co-authored-by 兜底层：AI 会话（zcode）中的 git commit 缺 trailer 时自动补齐。
# 提醒层由本插件 pre-tool-use.mjs 承担（模型写完整版
# Co-authored-by: ZCode (<模型名>) <noreply@z.ai>）；本脚本只兜底补
# 不带模型名的版本（shell 拿不到模型名）。
#
# 安装（全局生效，见插件 README）：
#   mkdir -p ~/.config/git/hooks
#   ln -sf <插件根>/git-hooks/prepare-commit-msg ~/.config/git/hooks/
#   ln -sf <插件根>/git-hooks/forward-to-repo-hook ~/.config/git/hooks/<各转发名>
#   git config --global core.hooksPath ~/.config/git/hooks

set -u

# 仅 AI 环境生效：zcode 的 Bash 工具子进程带 ZCODE_APP_VERSION，手动终端没有
[ -n "${ZCODE_APP_VERSION:-}" ] || exit 0

# 只处理常规提交路径：$2 为空（编辑器）、message（-m/-F）、template（模板）。
# merge/squash/amend($2=commit) 不动。
case "${2:-}" in
  "" | message | template) ;;
  *) exit 0
esac

# 模型已按提醒写了 Co-authored-by（含 ZCode 署名）则不覆盖；
# 他人/其他 agent 的 Co-authored-by 行不算，仍需补本会话署名
grep -qi '^Co-authored-by:.*zcode' "$1" && exit 0

printf '\nCo-authored-by: ZCode <noreply@z.ai>\n' >>"$1"
exit 0
