{
  "plugins": {
    "dirs": [
      "/home/brokenshine/.zcode/plugins/agenote-zcode",
      "/home/brokenshine/.zcode/plugins/assisted-by-zcode"
    ],
    "enabledPlugins": {
      "superpowers@zcode-plugins-official": false,
      "mimosa@zcode-plugins-official": true,
      "example-plugin@zcode-plugins-official": true,
      "restore-legacy-sessions@zcode-plugins-official": true
    }
  },
  "mcp": {
    "servers": {}
  },
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "/home/brokenshine/.zcode/hooks/session-start.sh",
              "timeout": 10
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "/home/brokenshine/.zcode/hooks/bash-gate.sh",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "/home/brokenshine/.zcode/hooks/edit-gate.sh",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
