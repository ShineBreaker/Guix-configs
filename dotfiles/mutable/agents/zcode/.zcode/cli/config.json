{
  "plugins": {
    "dirs": [
      "/home/brokenshine/.zcode/plugins/agenote-zcode",
      "/home/brokenshine/.zcode/plugins/assisted-by-zcode"
    ],
    "enabledPlugins": {
      "superpowers@zcode-plugins-official": false,
      "context7@claude-plugins-official": true,
      "feature-dev@claude-plugins-official": true,
      "playwright@claude-plugins-official": true,
      "github@zcode-plugins-official": true,
      "code-review@claude-plugins-official": true,
      "video-agent-kit@zcode-plugins-official": false,
      "computer-use@zcode-plugins-official": true,
      "example-plugin@zcode-plugins-official": false,
      "cloudflare@claude-plugins-official": true,
      "restore-legacy-sessions@zcode-plugins-official": false,
      "mimosa@zcode-plugins-official": false,
      "jupyter-notebook@zcode-plugins-official": true,
      "typst-workbench@zcode-plugins-official": true,
      "video2code@zcode-plugins-official": true,
      "libtv-cli@zcode-plugins-official": true,
      "godot@zcode-plugins-official": true
    }
  },
  "mcp": {
    "servers": {
      "cua-driver": {
        "type": "stdio",
        "command": "cua-driver",
        "args": []
      },
      "rea": {
        "command": "npx",
        "args": [
          "-y",
          "rea-agents@6.8.0",
          "mcp"
        ]
      }
    }
  },
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "/home/brokenshine/.zcode/hooks/session-start.sh",
              "timeout": 10
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "/home/brokenshine/.zcode/hooks/bash-gate.sh",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "/home/brokenshine/.zcode/hooks/edit-gate.sh",
              "timeout": 10
            }
          ]
        }
      ]
    }
  },
  "features": {
    "memory": false
  }
}
