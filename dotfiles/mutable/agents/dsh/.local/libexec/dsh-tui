# dsh tui — dsh-TUI 插件启动器（bin/dsh 的 tui 子命令与桌面入口共用）。
# 上游 dsh-tui bin 是双态启动器：全局 npm 那份只是找 profile 副本委托的瘦壳，
# 本脚本直接执行 profile 内完整副本（DSH_TUI_BIN 可覆盖）。launcher 独有子命令
# （version/doctor/safe/update/--resume）只在这一层；一包一入口规则下挂靠成
# dsh 子命令是唯一合规形态。文档：docs/scripts/dsh.md
set -euo pipefail

: "${DSH_HOME:=${XDG_DATA_HOME:-$HOME/.local/share}/dsh}"
export DSH_HOME

_tui_bin="${DSH_TUI_BIN:-$DSH_HOME/profiles/dsh-tui/node_modules/@deepseek-harness-tui/dsh-tui/bin/dsh-tui.js}"

if [[ ! -r "$_tui_bin" ]]; then
  printf 'dsh tui: 找不到 %s\n' "$_tui_bin" >&2
  printf 'dsh tui: 先安装插件：dsh plugin --profile dsh-tui add @deepseek-harness-tui/dsh-tui@<版本>\n' >&2
  exit 127
fi

exec node "$_tui_bin" "$@"
