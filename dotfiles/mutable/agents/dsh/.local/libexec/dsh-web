#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# dsh web — DeepSeek Harness Web UI 启动实体（bin/dsh 的 web 子命令与
# desktop 入口共用）：chromium --app 窗口 + 尾网远程信任 + launch token 认证。
# 文档：docs/scripts/dsh.md §dsh web（token/cookie/app_id/远程机制与全部环境变量）
set -euo pipefail

: "${DSH_HOME:=${XDG_DATA_HOME:-$HOME/.local/share}/dsh}"
export DSH_HOME
: "${AGENTS_ROOT:=${XDG_DATA_HOME:-$HOME/.local/share}/agents}"
export AGENTS_ROOT
: "${DSH_WEB_PORT:=3080}"
: "${DSH_WEB_LOG:=${XDG_STATE_HOME:-$HOME/.local/state}/dsh/web.log}"
# 起服务必须直调 CLI 本体：dsh 公共入口会把 web 分发回本脚本造成递归；
# DSH_BIN 覆盖测试时同理须指向 CLI 本体
: "${DSH_BIN:=${AGENTS_ROOT}/dsh/node_modules/.bin/dsh}"
# 默认值用 = 而非 :=：显式空串（DSH_TS_HOST= dsh web）表示本次不带
# 尾网信任，空串须原样保留不得填默认
: "${DSH_TS_HOST=brokenshine-laptop.tail3889e8.ts.net}"

readonly CLEAN_URL="http://127.0.0.1:${DSH_WEB_PORT}/"
readonly DSH_WEB_PROFILE=dsh

usage() {
	cat >&2 <<'EOF'
dsh web — DeepSeek Harness Web UI 启动实体
用法: dsh web [--reauth] [--no-window] [--remote-url] [--lan-off]
  (无参数)     起服务（默认带远程信任）并开本机窗口
  --reauth     强制重启服务换新 token（cookie 失效时用）
  --no-window  只确保服务在跑，不开窗：打印带 token 的 URL 后退出
               （脚本化重启用，如 dsh update 的自动重启）
  --remote-url 只打印手机首次握手的 https://<尾网主机名>/?token=... URL
  --lan-off    本次不带 --trusted-host 启动（DSH_TS_HOST= 的显式等价）

另有 --service：shepherd 常驻服务专用入口（见 source/config.org 的
dsh-web-service），断链自愈后直接 exec CLI 本体，不走窗口与端口探测逻辑。
EOF
}

server_up() { (exec 3<>"/dev/tcp/127.0.0.1/${DSH_WEB_PORT}") 2>/dev/null; }

# 监听中的实例是否已带本尾网 host（/proc/<pid>/cmdline 匹配 argv）
server_trusted() {
	local pid cmdline
	pid=$(ss -tlnpH "sport = :${DSH_WEB_PORT}" 2>/dev/null |
		sed -n 's/.*pid=\([0-9]\{1,\}\).*/\1/p' | head -n 1)
	[[ -z "$pid" ]] && return 1
	[[ -r "/proc/${pid}/cmdline" ]] || return 1
	cmdline=$(tr '\0' ' ' <"/proc/${pid}/cmdline")
	[[ "$cmdline" == *"--trusted-host ${DSH_TS_HOST}"* ]]
}

chromium_bin() {
	if command -v chromium >/dev/null 2>&1; then
		command -v chromium
	elif [[ -x "$HOME/.guix-home/profile/bin/chromium" ]]; then
		printf '%s\n' "$HOME/.guix-home/profile/bin/chromium"
	else
		return 1
	fi
}

stop_server() {
	local pid waited=0 cmdline=x
	pid=$(ss -tlnpH "sport = :${DSH_WEB_PORT}" 2>/dev/null |
		sed -n 's/.*pid=\([0-9]\{1,\}\).*/\1/p' | head -n 1)
	if [[ -z "$pid" ]]; then
		printf 'dsh web: 端口 %s 上没有监听进程\n' "$DSH_WEB_PORT" >&2
		return 1
	fi
	if [[ -r "/proc/${pid}/cmdline" ]]; then
		cmdline=$(tr '\0' ' ' <"/proc/${pid}/cmdline")
	fi
	if [[ "$cmdline" != *"@deepseek-ai/dsh"* ]]; then
		printf 'dsh web: pid=%s 不是 dsh CLI（%s），拒绝终止\n' "$pid" "$cmdline" >&2
		return 1
	fi
	printf 'dsh web: --reauth 终止 pid=%s\n' "$pid" >&2
	kill "$pid"
	while ((waited < 40)); do
		server_up || return 0
		sleep 0.25
		waited=$((waited + 1))
	done
	printf 'dsh web: pid=%s 在 10s 内没有退出\n' "$pid" >&2
	return 1
}

# desktop 入口没有终端可看，起不来时靠桌面通知让失败可见
report_start_failure() {
	local detail
	detail=$(tail -n 3 "$DSH_WEB_LOG" 2>/dev/null | tr '\n' ' ')
	printf 'dsh web: dsh web 未能起来，%s 末尾：\n' "$DSH_WEB_LOG" >&2
	tail -n 20 "$DSH_WEB_LOG" >&2 || true
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -a dsh web -u critical 'dsh web 启动失败' "${detail:-详见 $DSH_WEB_LOG}" 2>/dev/null || true
}

# 断链自愈：dsh 的原子写会把 stow 软链换成实体文件——内容归源再重建软链；
# lockfile 反向只回拷内容（pnpm 拒写软链 lockfile）。与 bin/dsh 的同款函数
# 保持一致：--service 是 shepherd 的启动入口，不经 wrapper，安装树 + 两个
# profile 三棵树都要在此覆盖；重建必须用相对链——绝对链 stow 拒绝接管，
# --restow 报 not owned by stow 并整包中止
_relink_dir() {
	local label="$1" dir="$2" src_dir="$3" name rel
	[[ -d "$src_dir" ]] || return 0
	for name in package.json pnpm-workspace.yaml cordis.patch.yml; do
		[[ -f "$dir/$name" && -f "$src_dir/$name" ]] || continue
		if [[ ! -L "$dir/$name" ]]; then
			cp "$dir/$name" "$src_dir/$name"
			rel="$(realpath --relative-to="$dir" "$src_dir/$name")"
			ln -sfn "$rel" "$dir/$name"
			printf 'dsh web: [%s] %s 断链已写回仓库源并重建软链\n' "$label" "$name" >&2
		fi
	done
	if [[ -f "$dir/pnpm-lock.yaml" && -f "$src_dir/pnpm-lock.yaml" ]] &&
		! cmp -s "$dir/pnpm-lock.yaml" "$src_dir/pnpm-lock.yaml"; then
		cp "$dir/pnpm-lock.yaml" "$src_dir/pnpm-lock.yaml"
		printf 'dsh web: [%s] pnpm-lock.yaml 已同步回仓库源\n' "$label" >&2
	fi
}

_relink_profile() {
	local pkg_local
	pkg_local="$(dirname "$(dirname "$(readlink -f "$0")")")"
	_relink_dir 安装树 "$AGENTS_ROOT/dsh" "$pkg_local/share/agents/dsh"
	_relink_dir web "$DSH_HOME/profiles/web" "$pkg_local/share/dsh/profiles/web"
	_relink_dir dsh-tui "$DSH_HOME/profiles/dsh-tui" "$pkg_local/share/dsh/profiles/dsh-tui"
}

start_server_url() {
	local dir url="" waited=0 child
	_relink_profile
	dir=$(dirname -- "$DSH_WEB_LOG")
	mkdir -p -- "$dir"
	(
		umask 077
		: >"$DSH_WEB_LOG"
	)
	# setsid -w：脱离 desktop 入口会话，且留有同寿命 pid 供 kill -0 早判失败
	setsid -w "$DSH_BIN" web --no-open --port "$DSH_WEB_PORT" "$@" \
		>"$DSH_WEB_LOG" 2>&1 </dev/null &
	child=$!
	while ((waited < 120)); do
		url=$(sed -n 's/.*dsh web: \(http:\/\/[^ 	]\{1,\}\).*$/\1/p' "$DSH_WEB_LOG" | head -n 1)
		if [[ -n "$url" ]]; then
			printf '%s\n' "$url"
			return 0
		fi
		if ! kill -0 "$child" 2>/dev/null; then
			report_start_failure
			return 1
		fi
		sleep 0.5
		waited=$((waited + 1))
	done
	report_start_failure
	return 1
}

# launch token 一次性：已消耗的握手必失败，--reauth 换新。0.2.x 起 CLI 给
# 日志行加了时间戳前缀，匹配不能锚定行首，取最后一条（最新 boot 的 token）
launch_token() {
	sed -n 's/.*dsh web: http:\/\/127\.0\.0\.1:'"${DSH_WEB_PORT}"'\/?token=\([^ 	]\{1,\}\).*$/\1/p' \
		"$DSH_WEB_LOG" 2>/dev/null | tail -n 1
}

# dsh-web 常驻服务（home-shepherd）接管 server 启停后，本脚本再自行 spawn
# 会与服务抢 3080 端口，服务连续 EADDRINUSE 触发 respawn 上限即自禁用；
# 检测到服务注册，启停一律改经 herd
service_managed() { command -v herd >/dev/null 2>&1 && herd status dsh-web >/dev/null 2>&1; }

# 经 herd 重启并等新 token（--reauth / 服务未起 / 实例未 trusted 共用）。
# 日志不 truncate，靠 token 值变化识别新 boot，避免拿到上一次的已死 token
managed_restart_url() {
	local old new waited=0
	old=$(launch_token)
	herd restart dsh-web >/dev/null 2>&1
	while ((waited < 120)); do
		new=$(launch_token)
		if [[ -n "$new" && "$new" != "$old" ]]; then
			printf 'http://127.0.0.1:%s/?token=%s\n' "$DSH_WEB_PORT" "$new"
			return 0
		fi
		sleep 0.5
		waited=$((waited + 1))
	done
	report_start_failure
	return 1
}

reauth=false
remote_url=false
no_window=false
service_mode=false
passthrough=()
while [[ $# -gt 0 ]]; do
	case "$1" in
	--reauth) reauth=true ;;
	--remote-url) remote_url=true ;;
	--no-window) no_window=true ;;
	--service) service_mode=true ;;
	--lan-off) DSH_TS_HOST="" ;;
	-h | --help)
		usage
		exit 0
		;;
	*) passthrough+=("$1") ;;
	esac
	shift
done

# 尾网信任参数（--lan-off 或 DSH_TS_HOST 空串时不带）。必须在参数解析
# **之后**计算：--lan-off 在解析中才置空 DSH_TS_HOST，提前冻结会让该旗标
# 永远不生效（存量 bug，2026-10-30 修正）
ts_args=()
if [[ -n "${DSH_TS_HOST:-}" ]]; then
	ts_args=(--trusted-host "$DSH_TS_HOST")
fi

# --service：shepherd 常驻服务专用入口。先跑断链自愈（服务不经 bin/dsh
# wrapper，UI 运行期对 cordis.patch.yml 的原子写断掉的 stow 软链在每次
# 服务启动/respawn 时归位），再 exec CLI 本体——常驻职责（respawn、日志、
# requirement）在 shepherd，此处不做端口探测与开窗
if $service_mode; then
	_relink_profile
	# shepherd 从 tty 登录启动，环境里没有 WAYLAND_DISPLAY；缺了它
	# pinentry-qt 会回退 curses 并对 /dev/null 报 ENOTTY，GPG 签名必败
	if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
		_uid=$(id -u)
		for s in /run/user/$_uid/wayland-*; do
			[[ -S "$s" ]] || continue
			case "$s" in *.lock) continue ;; esac
			export WAYLAND_DISPLAY="${s##*/}"
			break
		done
	fi
	exec "$DSH_BIN" web --no-open --port "$DSH_WEB_PORT" "${ts_args[@]}"
fi

# --remote-url：不弹窗，只保证实例 trusted 并打印握手 URL
if $remote_url; then
	if [[ -z "$DSH_TS_HOST" ]]; then
		echo "dsh web: --remote-url 需要尾网主机名（DSH_TS_HOST 为空）" >&2
		exit 2
	fi
	if server_up && server_trusted; then
		: # 已就绪
	elif service_managed; then
		printf 'dsh web: 经 herd 重启 dsh-web 服务……\n' >&2
		managed_restart_url >/dev/null || {
			echo "dsh web: 服务启动失败" >&2
			exit 1
		}
	elif server_up; then
		printf 'dsh web: 现有实例未带 --trusted-host，重启中……\n' >&2
		stop_server
		start_server_url "${ts_args[@]}" >/dev/null || {
			echo "dsh web: 服务启动失败" >&2
			exit 1
		}
	else
		start_server_url "${ts_args[@]}" >/dev/null || {
			echo "dsh web: 服务启动失败" >&2
			exit 1
		}
	fi
	token=""
	for _ in $(seq 1 24); do
		token=$(launch_token)
		[[ -n "$token" ]] && break
		sleep 0.5
	done
	echo "已握手设备日常入口: https://${DSH_TS_HOST:-<未配置>}/"
	if [[ -n "$token" ]]; then
		echo "首次握手（30 天有效）: https://${DSH_TS_HOST}/?token=${token}"
	else
		echo "dsh web: 未在日志找到 token；稍候重跑或 --reauth 换新" >&2
	fi
	exit 0
fi

# 常规路径：服务由 shepherd 托管时启停经 herd（防双起抢端口），否则维持
# 按端口探测 + 自行 spawn 的原行为
url=""
if service_managed; then
	if $reauth || ! server_up || { [[ -n "${DSH_TS_HOST:-}" ]] && ! server_trusted; }; then
		printf 'dsh web: 经 herd 重启 dsh-web 服务……\n' >&2
		url=$(managed_restart_url) || exit 1
	fi
else
	if [[ -n "${DSH_TS_HOST:-}" ]] && server_up && ! server_trusted; then
		printf 'dsh web: 实例未带 --trusted-host，自动重启以启用远程入口……\n' >&2
		stop_server
	fi
	if $reauth; then
		stop_server
	fi
fi

if [[ -z "$url" ]]; then
	if server_up; then
		url="$CLEAN_URL"
	else
		url=$(start_server_url "${ts_args[@]}" "${passthrough[@]}")
	fi
fi

# --no-window：服务已就绪即收尾，打印带 token 的 URL（首次握手/脚本化
# curl 验证用）后退出，不开 chromium 窗口——cookie 让既有窗口自动重连
if $no_window; then
	printf '%s\n' "$url"
	exit 0
fi

chromium=$(chromium_bin) || {
	printf 'dsh web: 找不到 chromium（ungoogled-chromium-wayland 未装或不在 PATH）\n' >&2
	exit 127
}

exec "$chromium" --profile-directory="$DSH_WEB_PROFILE" \
	--app="$url" --no-first-run --no-default-browser-check
