#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# dsh web — DeepSeek Harness Web UI 启动实体（bin/dsh 的 web 子命令与 desktop
# 入口共用；一包一入口布局见 bin/dsh）。
#
# DSH_HOME 在此自行注入（niri 会话环境不经 fish conf.d，desktop 入口拿不到
# export）。窗口走 chromium 的 --app 模式：无标签栏/地址栏，只留内容区；不装
# PWA——dsh 自带 manifest 声明 display=fullscreen，装出来是全屏而非窗口。
#
# 认证：launch token 按进程随机、且一个 token 只换一次 cookie，所以只有本
# 脚本亲自起的实例才拿得到它的 token URL；「已在监听但不是本脚本起的」
# 实例只能用 --reauth 重启换新 token。换到的 cookie 由 DSH_HOME 里持久化的密钥
# 签名（30 天，跨重启有效），之后直接开干净 URL。
#
# 远程（默认开启）：实例永远带 --trusted-host <尾网主机名> 启动，配合
# tailscale serve 反代（https://<主机名> → 127.0.0.1:$DSH_WEB_PORT），手机等
# 尾网设备可远程操控同一实例（会话数据共享；cookie 按 authority 分离互不干扰）。
# dsh web --remote-url 打印手机首次握手用的 token URL。DSH_TS_HOST= 空串可关闭。
#
# 窗口 app_id 在 Wayland 下只由 profile 目录名决定（chrome-<host>__-<profile>）：实测
# 协议层只发一次 set_app_id，值是 Chromium 自己算的 web-app id，--class 的值根本不出现，
# 所以 app 窗口改不了 app_id（普通窗口读 --class）。定死 --profile-directory=dsh 得到
# chrome-127.0.0.1__-dsh，与 dsh.desktop 的 StartupWMClass 成对绑定（改名要同时改两处）。
# 该 profile 顺带把 dsh 的会话 cookie 与日常浏览的 Default profile 隔开。
#
# 环境覆盖：DSH_WEB_PORT（端口；改了 authority 也变，cookie 需重新握手）、
# DSH_WEB_LOG（服务 stdout，含一次性 token URL）、DSH_BIN（测试用：默认直调
# CLI 本体起服务，覆盖成 dsh 公共入口会经其 web 分发回到本脚本造成递归）、
# DSH_TS_HOST（尾网主机名，默认 brokenshine-laptop.tail3889e8.ts.net）。
set -euo pipefail

: "${DSH_HOME:=${XDG_DATA_HOME:-$HOME/.local/share}/dsh}"
export DSH_HOME
: "${DSH_WEB_PORT:=3080}"
: "${DSH_WEB_LOG:=${XDG_STATE_HOME:-$HOME/.local/state}/dsh/web.log}"
# 起服务直调 CLI 本体：web --no-open 是上游子命令，不经 dsh 公共入口（后者
# 会把 web 分发回本脚本造成递归）；DSH_BIN 覆盖测试时同理须指向 CLI 本体。
: "${DSH_BIN:=${DSH_HOME}/_cli/node_modules/.bin/dsh}"
: "${DSH_TS_HOST:=brokenshine-laptop.tail3889e8.ts.net}"

readonly CLEAN_URL="http://127.0.0.1:${DSH_WEB_PORT}/"
readonly DSH_WEB_PROFILE=dsh

usage() {
	sed -n 's/^# dsh web — //p' "$0" | head -1 >&2
	echo "用法: dsh web [--reauth] [--remote-url] [--lan-off]" >&2
	echo "  (无参数)     起服务（默认带远程信任）并开本机窗口" >&2
	echo "  --reauth     强制重启服务换新 token（cookie 失效时用）" >&2
	echo "  --remote-url 只打印手机首次握手的 https://<尾网主机名>/?token=... URL" >&2
	echo "  --lan-off    本次不带 --trusted-host 启动（DSH_TS_HOST= 的显式等价）" >&2
}

# 尾网信任参数（--lan-off 或 DSH_TS_HOST 空串时不带）
ts_args=()
if [[ -n "${DSH_TS_HOST:-}" ]]; then
	ts_args=(--trusted-host "$DSH_TS_HOST")
fi

server_up() { (exec 3<>"/dev/tcp/127.0.0.1/${DSH_WEB_PORT}") 2>/dev/null; }

# 判断监听中的实例是否已带本尾网 host（/proc/<pid>/cmdline 匹配）
server_trusted() {
	local pid cmdline
	pid=$(ss -tlnpH "sport = :${DSH_WEB_PORT}" 2>/dev/null |
		sed -n 's/.*pid=\([0-9]\{1,\}\).*/\1/p' | head -n 1)
	[[ -z "$pid" ]] && return 1
	[[ -r "/proc/${pid}/cmdline" ]] || return 1
	cmdline=$(tr '\0' ' ' <"/proc/${pid}/cmdline")
	[[ "$cmdline" == *"--trusted-host ${DSH_TS_HOST}"* ]]
}

chromium_bin() {
	if command -v chromium >/dev/null 2>&1; then
		command -v chromium
	elif [[ -x "$HOME/.guix-home/profile/bin/chromium" ]]; then
		printf '%s\n' "$HOME/.guix-home/profile/bin/chromium"
	else
		return 1
	fi
}

stop_server() {
	local pid waited=0 cmdline=x
	pid=$(ss -tlnpH "sport = :${DSH_WEB_PORT}" 2>/dev/null |
		sed -n 's/.*pid=\([0-9]\{1,\}\).*/\1/p' | head -n 1)
	if [[ -z "$pid" ]]; then
		printf 'dsh web: 端口 %s 上没有监听进程\n' "$DSH_WEB_PORT" >&2
		return 1
	fi
	if [[ -r "/proc/${pid}/cmdline" ]]; then
		cmdline=$(tr '\0' ' ' <"/proc/${pid}/cmdline")
	fi
	if [[ "$cmdline" != *"@deepseek-ai/dsh"* ]]; then
		printf 'dsh web: pid=%s 不是 dsh CLI（%s），拒绝终止\n' "$pid" "$cmdline" >&2
		return 1
	fi
	printf 'dsh web: --reauth 终止 pid=%s\n' "$pid" >&2
	kill "$pid"
	while ((waited < 40)); do
		server_up || return 0
		sleep 0.25
		waited=$((waited + 1))
	done
	printf 'dsh web: pid=%s 在 10s 内没有退出\n' "$pid" >&2
	return 1
}

# 服务起不来时 desktop 入口没有终端可看，靠桌面通知让失败可见
report_start_failure() {
	local detail
	detail=$(tail -n 3 "$DSH_WEB_LOG" 2>/dev/null | tr '\n' ' ')
	printf 'dsh web: dsh web 未能起来，%s 末尾：\n' "$DSH_WEB_LOG" >&2
	tail -n 20 "$DSH_WEB_LOG" >&2 || true
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -a dsh web -u critical 'dsh web 启动失败' "${detail:-详见 $DSH_WEB_LOG}" 2>/dev/null || true
}

start_server_url() {
	local dir url="" waited=0 child
	dir=$(dirname -- "$DSH_WEB_LOG")
	mkdir -p -- "$dir"
	(
		umask 077
		: >"$DSH_WEB_LOG"
	)
	# setsid -w 脱离 desktop 入口的会话，同时留一个与子进程同寿命的 pid，
	# 让下面的 kill -0 能在服务刚起就失败时立刻收手，不必干等满超时
	setsid -w "$DSH_BIN" web --no-open --port "$DSH_WEB_PORT" "$@" \
		>"$DSH_WEB_LOG" 2>&1 </dev/null &
	child=$!
	while ((waited < 120)); do
		url=$(sed -n 's/^dsh web: \([^ 	]\{1,\}\).*$/\1/p' "$DSH_WEB_LOG" | head -n 1)
		if [[ -n "$url" ]]; then
			printf '%s\n' "$url"
			return 0
		fi
		if ! kill -0 "$child" 2>/dev/null; then
			report_start_failure
			return 1
		fi
		sleep 0.5
		waited=$((waited + 1))
	done
	report_start_failure
	return 1
}

# 从日志提取本实例最新的 launch token（token 一次性；已消耗的会握手失败，
# 此时 --reauth 重启换新）
launch_token() {
	sed -n 's/^dsh web: http:\/\/127\.0\.0\.1:'"${DSH_WEB_PORT}"'\/?token=\([^ 	]\{1,\}\).*$/\1/p' \
		"$DSH_WEB_LOG" 2>/dev/null | tail -n 1
}

reauth=false
remote_url=false
passthrough=()
while [[ $# -gt 0 ]]; do
	case "$1" in
	--reauth) reauth=true ;;
	--remote-url) remote_url=true ;;
	--lan-off) DSH_TS_HOST="" ;;
	-h | --help) usage; exit 0 ;;
	*) passthrough+=("$1") ;;
	esac
	shift
done

# --remote-url：不弹窗，只保证实例 trusted 并打印握手 URL（手机入口辅助）
if $remote_url; then
	if [[ -z "$DSH_TS_HOST" ]]; then
		echo "dsh web: --remote-url 需要尾网主机名（DSH_TS_HOST 为空）" >&2
		exit 2
	fi
	if server_up && server_trusted; then
		: # 已就绪
	elif server_up; then
		printf 'dsh web: 现有实例未带 --trusted-host，重启中……\n' >&2
		stop_server
		start_server_url "${ts_args[@]}" >/dev/null || {
			echo "dsh web: 服务启动失败" >&2
			exit 1
		}
	else
		start_server_url "${ts_args[@]}" >/dev/null || {
			echo "dsh web: 服务启动失败" >&2
			exit 1
		}
	fi
	token=""
	for _ in $(seq 1 24); do
		token=$(launch_token)
		[[ -n "$token" ]] && break
		sleep 0.5
	done
	echo "已握手设备日常入口: https://${DSH_TS_HOST:-<未配置>}/"
	if [[ -n "$token" ]]; then
		echo "首次握手（30 天有效）: https://${DSH_TS_HOST}/?token=${token}"
	else
		echo "dsh web: 未在日志找到 token；稍候重跑或 --reauth 换新" >&2
	fi
	exit 0
fi

# 常规路径：需要远程但实例未 trusted 时自动重启（从应用菜单打开即自动生效，
# 无需手动步骤；仅在远程被关闭时跳过）
if [[ -n "$DSH_TS_HOST" ]] && server_up && ! server_trusted; then
	printf 'dsh web: 实例未带 --trusted-host，自动重启以启用远程入口……\n' >&2
	stop_server
fi
if $reauth; then
	stop_server
fi

if server_up; then
	url="$CLEAN_URL"
else
	url=$(start_server_url "${ts_args[@]}" "${passthrough[@]}")
fi

chromium=$(chromium_bin) || {
	printf 'dsh web: 找不到 chromium（ungoogled-chromium-wayland 未装或不在 PATH）\n' >&2
	exit 127
}

exec "$chromium" --profile-directory="$DSH_WEB_PROFILE" \
	--app="$url" --no-first-run --no-default-browser-check
