#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# dsh — DeepSeek Harness CLI wrapper：注入 DSH_HOME（niri 会话不经 fish
# conf.d），分发 update/web/tui 到同包 libexec 实体（一包一入口），CLI 本体在
# $AGENTS_ROOT/dsh 经 pnpm 安装。文档：docs/scripts/dsh.md
set -euo pipefail

: "${DSH_HOME:=${XDG_DATA_HOME:-$HOME/.local/share}/dsh}"
export DSH_HOME

# 各 agent 的 pnpm 安装树聚合根：CLI 本体项目（package.json + node_modules）落
# 在这里，DSH_HOME 只留配置与运行时状态（profiles/sessions/凭据）
: "${AGENTS_ROOT:=${XDG_DATA_HOME:-$HOME/.local/share}/agents}"
export AGENTS_ROOT

_cli_dir="$AGENTS_ROOT/dsh"
_cli_bin="$_cli_dir/node_modules/.bin/dsh"
# $0 经 stow 直链解析回仓库源，与同包 libexec/ 自洽
_libexec_dir="$(dirname "$(dirname "$(readlink -f "$0")")")/libexec"

install_cli() {
  if ! command -v pnpm >/dev/null 2>&1; then
    printf 'dsh: 找不到 pnpm（本机在 nix profile），无法安装 CLI\n' >&2
    return 1
  fi
  if [[ ! -f "$_cli_dir/package.json" ]]; then
    printf 'dsh: %s/package.json 不存在（应由 blue stow 从 dotfiles/mutable/agents/dsh 链出）\n' "$_cli_dir" >&2
    return 1
  fi
  printf 'dsh: 正在安装 CLI（在 %s 里跑 pnpm install）\n' "$_cli_dir" >&2
  (cd "$_cli_dir" && pnpm install)
  if [[ ! -x "$_cli_bin" ]]; then
    printf 'dsh: pnpm install 结束但仍没有 %s\n' "$_cli_bin" >&2
    return 1
  fi
  _sync_cli_lockfile
}

# 部署侧 lockfile 拷回仓库源：pnpm 拒绝写软链 lockfile，部署侧只能是真实文件
_sync_cli_lockfile() {
  local dir="$_cli_dir" src_file
  src_file="$(dirname "$(dirname "$(readlink -f "$0")")")/share/agents/dsh/pnpm-lock.yaml"
  [[ -f "$dir/pnpm-lock.yaml" && -f "$src_file" ]] || return 0
  if ! cmp -s "$dir/pnpm-lock.yaml" "$src_file"; then
    cp "$dir/pnpm-lock.yaml" "$src_file"
    printf 'dsh: _cli 的 pnpm-lock.yaml 已同步回仓库源\n' >&2
  fi
}

if [[ "${1:-}" == "--install" ]]; then
  install_cli
  printf 'dsh: CLI 安装完成\n' >&2
  exit 0
fi

# 断链自愈：dsh 的原子写（临时文件 + rename；plugin bundles、UI 设置编辑
# cordis.patch.yml、pnpm 覆写 package.json）会把 stow 软链换成独立文件——内容
# 先归源再重建软链；lockfile 反向只回拷内容（pnpm 拒写软链 lockfile，部署侧
# 必须真实文件）。覆盖两处 pnpm 项目：CLI 安装树（$AGENTS_ROOT/dsh）与 web
# profile。安装树是手动升级路径的回源盲区——改 package.json 后裸跑 pnpm
# install 不过 dsh update 的 sync，曾致仓库 lockfile 落后一个 minor（0.1.7 vs
# 部署侧 0.2.0），2026-10-02 在此补齐。源目录从 $0 解析回包内（stow 布局内
# 自洽，不从部署侧软链推导：pnpm 会把文件原地写成实体文件，链接随时不在）。
# 每次 CLI 调用尾部统一检测，开销可忽略（一次 cmp）。
_relink_dir() {
  local label="$1" dir="$2" src_dir="$3" name
  [[ -d "$src_dir" ]] || return 0
  for name in package.json pnpm-workspace.yaml cordis.patch.yml; do
    [[ -f "$dir/$name" && -f "$src_dir/$name" ]] || continue
    if [[ ! -L "$dir/$name" ]]; then
      cp "$dir/$name" "$src_dir/$name"
      ln -sfn "$src_dir/$name" "$dir/$name"
      printf 'dsh: [%s] %s 断链已写回仓库源并重建软链\n' "$label" "$name" >&2
    fi
  done
  if [[ -f "$dir/pnpm-lock.yaml" && -f "$src_dir/pnpm-lock.yaml" ]] \
    && ! cmp -s "$dir/pnpm-lock.yaml" "$src_dir/pnpm-lock.yaml"; then
    cp "$dir/pnpm-lock.yaml" "$src_dir/pnpm-lock.yaml"
    printf 'dsh: [%s] pnpm-lock.yaml 已同步回仓库源\n' "$label" >&2
  fi
}

_relink_profile() {
  local pkg_local
  pkg_local="$(dirname "$(dirname "$(readlink -f "$0")")")"
  _relink_dir 安装树 "$AGENTS_ROOT/dsh" "$pkg_local/share/agents/dsh"
  _relink_dir web "$DSH_HOME/profiles/web" "$pkg_local/share/dsh/profiles/web"
}

if [[ "${1:-}" == "plugin" ]]; then
  set +e
  "$_cli_bin" "$@"
  rc=$?
  set -e
  _relink_profile
  exit "$rc"
fi

# 拦截即覆写：`dsh update` / `dsh web` 遮蔽上游同名子命令为 Guix 增强版；
# 原生行为须直调 CLI 本体触达：$_cli_bin update|web。分发须在下方 CLI 缺失
# 检查之前（dsh-update 自身能装 CLI，dsh-web 的报错也更友好）。
# `dsh tui` 遮蔽为 dsh-tui 启动器——上游没有 tui 子命令，不涉及覆写。
case "${1:-}" in
  update) exec "$_libexec_dir/dsh-update" "${@:2}" ;;
  web) exec "$_libexec_dir/dsh-web" "${@:2}" ;;
  tui) exec "$_libexec_dir/dsh-tui" "${@:2}" ;;
esac

if [[ ! -x "$_cli_bin" ]]; then
  if [[ -t 0 ]]; then
    read -r -p 'dsh: CLI 尚未安装，现在装？（pnpm install，需联网、可能几分钟）[y/N] ' _reply || _reply=
    case "$_reply" in
      [yY] | [yY][eE][sS]) ;;
      *)
        printf 'dsh: 已取消，CLI 仍未安装\n' >&2
        exit 130
        ;;
    esac
    install_cli
  else
    printf 'dsh: CLI 尚未安装；非交互环境请先运行 dsh --install\n' >&2
    exit 127
  fi
fi

# 统一兜底：plugin 分支已提前 exit；update/web/tui 走 exec 由 libexec 负责
set +e
"$_cli_bin" "$@"
rc=$?
set -e
_relink_profile
exit "$rc"
