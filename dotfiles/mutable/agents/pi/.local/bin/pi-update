#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# pi-update — 更新 Pi 核心 + 扩展。settings.json 的 packages 数组是扩展清单的
# 唯一真源，package.json 是派生产物；用 pnpm update --latest 跨 semver 范围升级。
# pnpm 12 的供应链策略（minimumReleaseAge 24h 冷却、allowBuilds 审批）由
# pnpm_workspace_policy 统一落到各目录的 pnpm-workspace.yaml，否则更新会静默
# 不生效（新版本被冷却期排除）或 native 产物缺失（build scripts 未审批）。
# 文档：docs/scripts/pi-update.md
set -euo pipefail

# === 路径 ===
PI_DATA_DIR="${PI_LOCAL_ROOT:-${XDG_DATA_HOME:-${HOME}/.local/share}/pi}"
PI_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/pi"
EXT_DIR="${PI_CONFIG_DIR}/npm"
SETTINGS_FILE="${PI_CONFIG_DIR}/settings.json"
PI_BIN="${PI_DATA_DIR}/node_modules/.bin/pi"

# 需要本地编译产物的 native 包（prebuilt 平台包如 koffi 无需 rebuild）
NATIVE_PKGS=(better-sqlite3)

# settings.json 未列出时也保留的核心/框架包
PROTECTED_PKGS=(pi-subagents)

FAILED=()

# --extensions-only: 首装时由 bin/pi 调用，只装扩展、跳过核心更新和 native rebuild
EXTENSIONS_ONLY=0
if [[ "${1:-}" == "--extensions-only" ]]; then
  EXTENSIONS_ONLY=1
  shift
fi

# === 工具函数 ===

read_pi_version() {
  node -p "require('${PI_DATA_DIR}/node_modules/@earendil-works/pi-coding-agent/package.json').version" 2>/dev/null || echo '未知'
}

# nodeLinker=hoisted 必需：jiti 从 symlink 路径解析模块时找不到扩展的
# 传递依赖（如 @ff-labs/pi-fff → @ff-labs/fff-node）。pnpm 10+ 配置位置在
# pnpm-workspace.yaml（package.json 的 pnpm 字段已废弃）。
ensure_pnpm_workspace() {
  local dir="$1" ext_only="$2"
  local wsfile="$dir/pnpm-workspace.yaml"
  if [[ ! -f "$wsfile" ]]; then
    if [[ "$ext_only" == "yes" ]]; then
      printf 'nodeLinker: hoisted\n' >"$wsfile"
    else
      # 核心目录：pnpm 11 需要此文件管理 allowBuilds
      : >"$wsfile"
    fi
  elif [[ "$ext_only" == "yes" ]] && ! grep -q 'nodeLinker' "$wsfile"; then
    # 旧版脚本创建的文件可能缺此行，补齐
    echo "nodeLinker: hoisted" | cat - "$wsfile" >"$wsfile.tmp" && mv "$wsfile.tmp" "$wsfile"
  fi
  pnpm_workspace_policy "$wsfile" "" '{"minimumReleaseAge":0}'
}

# package.json 的 pnpm 字段已废弃且每次运行报 WARN，顺手清掉
strip_deprecated_pnpm_field() {
  local pkgfile="$1"
  [[ -f "$pkgfile" ]] || return 0
  node -e '
		const fs = require("fs");
		const [f] = process.argv.slice(1);
		const pkg = JSON.parse(fs.readFileSync(f, "utf8"));
		if (pkg.pnpm) {
			delete pkg.pnpm;
			fs.writeFileSync(f, JSON.stringify(pkg, null, 2) + "\n");
		}
	' "$pkgfile" || true
}

# pnpm-workspace.yaml 是 pnpm 10+ 唯一的项目级配置位置（package.json 的 pnpm
# 字段已废弃）。这里只做两件事，未知顶层键（pnpm 自己写入的
# minimumReleaseAgeExclude 等）原样保留：
#   1. scalars：写入/改写指定顶层标量键（minimumReleaseAge: 0——关闭 pnpm 12
#      默认的 24h 供应链冷却。pi/插件是日更 preview 版本，冷却期内发布的新版本
#      会被静默排除出解析，表现就是「更新成功但版本没动」）
#   2. builds：从 pnpm 的 ERR_PNPM_IGNORED_BUILDS 报告里解析被忽略 build
#      scripts 的包名，批准（true）后供调用方重试
# 用法：pnpm_workspace_policy <pnpm-workspace.yaml> <pnpm输出或空串> <scalarsJSON>
pnpm_workspace_policy() {
  node -e '
    const fs = require("fs");
    const [file, report, scalarsJson] = process.argv.slice(1);
    const scalars = scalarsJson ? JSON.parse(scalarsJson) : {};

    // ERR_PNPM_IGNORED_BUILDS 报告行："Ignored build scripts: a@1, b@2, ..."
    // 抓包名：去 ANSI 色、去 peer 后缀 (…)、去行尾 @version
    const builds = [];
    for (const m of (report || "").matchAll(/Ignored build scripts: ([^\n]+)/g)) {
      for (let name of m[1].split(",")) {
        name = name.replace(/\u001b\[[0-9;]*m/g, "").replace(/\(.*\)/, "").replace(/@[^@]*$/, "").trim();
        if (name && builds.indexOf(name) < 0) builds.push(name);
      }
    }

    const text = fs.existsSync(file) ? fs.readFileSync(file, "utf8") : "";
    const eol = text.indexOf("\r\n") >= 0 ? "\r\n" : "\n";
    const lines = text ? text.split(/\r?\n/) : [];
    if (lines.length && lines[lines.length - 1] === "") lines.pop();

    // 扁平结构解析：无缩进行是顶层 key（section），allowBuilds 下的缩进行是
    // 其子项；其余行原样保留
    const TOP = /^([A-Za-z0-9_.-]+):(.*)$/;
    const SUB = /^[ \t]+([^:]+):(.*)$/;
    const out = [];
    let section = "";
    let allowAt = -1;
    const approved = new Map();

    for (const line of lines) {
      if (TOP.test(line) && !/^\s/.test(line)) {
        section = TOP.exec(line)[1];
        if (section === "allowBuilds") {
          allowAt = out.length;
          out.push(null); // 占位，稍后整段按排序结果重换
          continue;
        }
        out.push(line);
        continue;
      }
      if (section === "allowBuilds") {
        const m = SUB.exec(line);
        if (m) {
          approved.set(m[1].trim().replace(/^[\u0027\u0022]|[\u0027\u0022]$/g, ""), m[2].trim());
          continue;
        }
      }
      out.push(line);
    }
    for (const name of builds) approved.set(name, "true");
    for (const [k, v] of Object.entries(scalars)) {
      const re = new RegExp("^" + k.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ":");
      const i = out.findIndex((l) => l !== null && re.test(l));
      if (i >= 0) out[i] = k + ": " + v;
      else out.push(k + ": " + v);
    }
    if (approved.size) {
      const q = (k) => (/^[A-Za-z0-9_][A-Za-z0-9_-]*$/.test(k) ? k : "\u0027" + k + "\u0027");
      const block = ["allowBuilds:"];
      for (const k of [...approved.keys()].sort()) block.push("  " + q(k) + ": " + approved.get(k));
      if (allowAt >= 0) out.splice(allowAt, 1, ...block);
      else out.push(...block);
    } else if (allowAt >= 0) {
      out.splice(allowAt, 1);
    }
    fs.writeFileSync(file, out.filter((l) => l !== null).join(eol) + eol);
  ' "$1" "$2" "$3"
}

update_latest() {
  local dir="$1" label="$2" is_ext="$3"
  ensure_pnpm_workspace "$dir" "$is_ext"
  strip_deprecated_pnpm_field "$dir/package.json"

  local out
  if out=$(cd "$dir" && pnpm update --latest 2>&1); then
    echo "$out"
    return 0
  fi

  # ERR_PNPM_IGNORED_BUILDS: 包装上了但 build scripts 没跑（esbuild 等 native
  # 产物缺失），按报告里的包名批准后重试一次——不是可以忽略的噪声
  if echo "$out" | grep -q 'ERR_PNPM_IGNORED_BUILDS'; then
    echo "  [${label}] 有依赖未审批 build scripts，自动批准并重试..." >&2
    pnpm_workspace_policy "$dir/pnpm-workspace.yaml" "$out" '{}'
    if out=$(cd "$dir" && pnpm update --latest 2>&1); then
      echo "$out"
      return 0
    fi
  fi

  # 其他错误（store 冲突、lockfile 损坏等）：删 lockfile 重装
  echo "$out" >&2
  echo "  [${label}] pnpm update --latest 失败，清除 lockfile 重装..." >&2
  (cd "$dir" && rm -f pnpm-lock.yaml && CI=true pnpm install --no-frozen-lockfile 2>&1)
}

# settings.json → package.json 派生同步
sync_extensions_from_settings() {
  [[ -f "$SETTINGS_FILE" ]] || {
    echo "  settings.json 不存在，跳过" >&2
    return 0
  }

  if [[ ! -f "$EXT_DIR/package.json" ]]; then
    mkdir -p "$EXT_DIR"
    echo '{"name":"pi-extensions","private":true,"type":"module","dependencies":{}}' \
      >"$EXT_DIR/package.json"
    echo "  package.json 缺失，已创建空壳" >&2
  fi

  local diff
  diff=$(node -e '
		const fs = require("fs");
		const [settingsFile, pkgFile, ...protect] = process.argv.slice(1);
		const cfg = JSON.parse(fs.readFileSync(settingsFile, "utf8"));
		const pkg = JSON.parse(fs.readFileSync(pkgFile, "utf8"));

		const desired = (cfg.packages || [])
			.filter(p => p.startsWith("npm:"))
			.map(p => p.slice(4));
		const current = Object.keys(pkg.dependencies || {});

		const add = desired.filter(p => !current.includes(p));
		const rem = current.filter(p =>
			!desired.includes(p) &&
			!p.startsWith("@earendil-works/") &&
			!protect.includes(p)
		);

		if (add.length) process.stdout.write("add:" + add.join(" ") + "\n");
		if (rem.length) process.stdout.write("remove:" + rem.join(" ") + "\n");
	' "$SETTINGS_FILE" "$EXT_DIR/package.json" "${PROTECTED_PKGS[@]}")

  if [[ -z "$diff" ]]; then
    echo "  无需变更"
    return 0
  fi

  while IFS= read -r line; do
    case "$line" in
      add:*)
        local pkgs="${line#add:}"
        echo "  安装: ${pkgs}"
        # shellcheck disable=SC2086  # pkgs 是空格分隔的包列表，须词分割
        (cd "$EXT_DIR" && pnpm add ${pkgs} 2>&1)
        ;;
      remove:*)
        local pkgs="${line#remove:}"
        echo "  移除: ${pkgs}"
        # shellcheck disable=SC2086  # pkgs 是空格分隔的包列表，须词分割
        (cd "$EXT_DIR" && pnpm remove ${pkgs} 2>&1)
        ;;
    esac
  done <<<"$diff"
}

rebuild_native_bindings() {
  echo "重建 native binding..."
  shopt -s nullglob
  for pkg in "${NATIVE_PKGS[@]}"; do
    printf "  %s ... " "$pkg"
    if ! (cd "$EXT_DIR" && pnpm rebuild "$pkg" >/dev/null 2>&1); then
      echo "rebuild 失败"
      FAILED+=("$pkg")
      continue
    fi
    # 通配兼顾 hoisted（顶层）与 isolated（.pnpm/）两种布局
    local found=0
    for d in "$EXT_DIR/node_modules/${pkg}" \
      "$EXT_DIR/node_modules/.pnpm/${pkg//\//+}@*"; do
      if find "$d" -name '*.node' 2>/dev/null | grep -q .; then
        found=1
        break
      fi
    done
    if [[ $found -eq 1 ]]; then
      echo "OK"
    else
      echo "binding 缺失!"
      FAILED+=("$pkg")
    fi
  done
  shopt -u nullglob
}

if ! command -v pnpm &>/dev/null; then
  echo "pnpm is not installed." >&2
  exit 1
fi

if [[ ! -x "$PI_BIN" ]]; then
  echo "Pi 核心未安装，执行首次安装..." >&2
  (cd "$PI_DATA_DIR" && CI=true pnpm install --no-frozen-lockfile)
fi

echo "当前版本: $(read_pi_version)"

if [[ $EXTENSIONS_ONLY -eq 0 ]]; then
  echo "更新 Pi 核心..."
  update_latest "$PI_DATA_DIR" "Pi 核心" "no"
fi

echo "同步扩展包（依据 settings.json）..."
sync_extensions_from_settings

echo "更新扩展..."
update_latest "$EXT_DIR" "扩展" "yes"

if [[ $EXTENSIONS_ONLY -eq 0 ]]; then
  rebuild_native_bindings
fi

echo ""
echo "更新后: $(read_pi_version)"
# wrapper 用 bun 跑 dist/bun/cli.js；上游若改 dist 布局，在此告警防扩展静默失效
PI_BUN_ENTRY="${PI_DATA_DIR}/node_modules/@earendil-works/pi-coding-agent/dist/bun/cli.js"
if [[ -f "$PI_BUN_ENTRY" ]]; then
  echo "Bun 入口: OK"
else
  echo "警告: 未找到 Bun 入口 $PI_BUN_ENTRY" >&2
  echo "      pi 将退回 node 运行，依赖 bun: 内置模块的扩展（如 atelier）无法加载。" >&2
fi
if [[ ${#FAILED[@]} -gt 0 ]]; then
  echo "失败: ${FAILED[*]}" >&2
  exit 1
fi
echo "提示: 已运行的 pi 进程仍用旧版本,需重启 pi 加载新代码"
