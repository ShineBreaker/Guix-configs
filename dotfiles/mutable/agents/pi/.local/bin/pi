#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# pi — Pi 启动入口：固定 PI_* 环境、首装 pnpm install、bun 入口优先 node 兜底。
# 文档：docs/scripts/pi.md
set -euo pipefail

PI_DATA_DIR="${PI_LOCAL_ROOT:-${XDG_DATA_HOME:-${HOME}/.local/share}/pi}"
PI_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}/pi"

# 必须显式赋值而非继承环境：这些变量 pi 与 omp 同名同义，残留的全局导出
# 会把 pi 指到 omp 的配置目录
export PI_HOME
export PI_CODING_AGENT_DIR="${PI_HOME}"
export PI_CONFIG_DIR=".config/pi"
export PI_CODING_AGENT_SESSION_DIR="${PI_DATA_DIR}/sessions"
export PI_OFFLINE="${PI_OFFLINE:-1}"
# 指错无害：pi-devin-local 对 DEVIN_CLI 只做 existsSync，失败静默回退原查找；
# 外部 export 优先（默认补 GUI 派生进程缺失的 nix profile 位置）
export DEVIN_CLI="${DEVIN_CLI:-${HOME}/.local/state/nix/profile/bin/devin}"

BIN="${PI_DATA_DIR}/node_modules/.bin/pi"
# 必须用 dist/bun/cli.js 而非 node 入口：扩展生态假定 Bun 运行时（bun:sqlite
# 等内置模块 node 解析不了）。该入口是上游 build:binary 的 Bun 入口。
PI_BUN_ENTRY="${PI_DATA_DIR}/node_modules/@earendil-works/pi-coding-agent/dist/bun/cli.js"

# GUI/编辑器派生进程的 PATH 可能不含 nix profile，兜底常见位置
PI_BUN_BIN="$(command -v bun 2>/dev/null || true)"
if [[ -z "${PI_BUN_BIN}" ]]; then
  for _cand in "${HOME}/.local/state/nix/profile/bin/bun" "/run/current-system/profile/bin/bun"; do
    if [[ -x "${_cand}" ]]; then
      PI_BUN_BIN="${_cand}"
      break
    fi
  done
fi

if [[ ! -x "${BIN}" ]]; then
  if ! command -v pnpm &>/dev/null; then
    echo "pnpm is not installed." >&2
    exit 1
  fi
  echo "Installing Pi dependencies..." >&2
  cd "${PI_DATA_DIR}" && pnpm install
  # readlink -f：stow 软链下 $0 可能是 symlink，须解析回包内找同目录 libexec
  _pi_update="$(dirname "$(readlink -f "$0")")/pi-update"
  if [[ -x "${_pi_update}" ]]; then
    echo "Installing Pi extensions..." >&2
    "${_pi_update}" --extensions-only || echo "  扩展安装失败，可用 pi-update 重试" >&2
  fi
fi

if [[ -n "${PI_BUN_BIN}" && -f "${PI_BUN_ENTRY}" ]]; then
  exec "${PI_BUN_BIN}" "${PI_BUN_ENTRY}" "$@"
fi

echo "警告: 无法用 bun 启动 pi（bun=${PI_BUN_BIN:-未找到}，入口=${PI_BUN_ENTRY}），" >&2
echo "      退回 node 入口；依赖 Bun 内置模块的扩展（如 atelier 的 bun:sqlite）会加载失败，" >&2
echo "      可用 'pi -ne' 临时跳过扩展。" >&2
exec "${BIN}" "$@"
