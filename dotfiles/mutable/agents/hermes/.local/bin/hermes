#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# hermes — Pi 式（editable-checkout）启动 wrapper。
#
# 与 Pi 的 pi wrapper 同构：
#   - runtime（checkout + venv）在 $HERMES_HOME/hermes-agent，
#     由 ../libexec/hermes-update 生成，不进 dotfiles 仓库（gitignore）。
#   - 首次未安装时 lazy bootstrap（调 ../libexec/hermes-update）。
#   - 启动前 unset PYTHONPATH/PYTHONHOME，避免 Guix Python 干扰
#     （与上游 install.sh 的 shim 行为一致）。
#   - update / desktop 子命令分发到同包 ../libexec/ 实体（一包一入口，
#     bin/ 只留 hermes 与 hermes-acp）。
# 布局常量与 HERMES_HOME 解析见兄弟层 ../libexec/hermes-lib.sh。
set -euo pipefail

_bin_dir="$(dirname "$(readlink -f "$0")")"
_libexec_dir="$(dirname "${_bin_dir}")/libexec"
# shellcheck disable=SC1091  # lib 移出 PATH（bin 的兄弟层 libexec/），按 stow 直链的源头 source
source "${_libexec_dir}/hermes-lib.sh"

# ── Guix 增强子命令分发 ────────────────────────────────────────────────
# 拦截即覆写：`hermes update` / `hermes desktop` 上游原生也有同名子命令，
# 此分发把这两个名字遮蔽为 Guix 增强版（libexec/hermes-update 的停旧
# gateway / uv 隔离 / 补丁重放 / herd 收尾，libexec/hermes-desktop 的
# FHS 容器壳）。原生行为须经 venv 直调路径触达：${HERMES_CLI_BIN}
# update|desktop——libexec/hermes-update 内部本就直调 venv 的
# `hermes update`，不经过本 wrapper，无递归。
case "${1:-}" in
  update)  exec "${_libexec_dir}/hermes-update" "${@:2}" ;;
  desktop) exec "${_libexec_dir}/hermes-desktop" "${@:2}" ;;
esac

# 首次未安装：引导（对齐 pi wrapper 的 lazy install）
if [[ ! -x "${HERMES_CLI_BIN}" ]]; then
  if [[ -x "${_libexec_dir}/hermes-update" ]]; then
    echo "Hermes 未安装，执行首次安装..." >&2
    "${_libexec_dir}/hermes-update" || { echo "安装失败，见上方错误" >&2; exit 1; }
  else
    echo "hermes-update 未找到，无法引导安装（期望位于 ${_libexec_dir}/hermes-update）" >&2
    exit 1
  fi
fi

# 清掉继承的 PYTHONPATH/PYTHONHOME，防 Guix Python 污染 venv 模块解析
unset PYTHONPATH
unset PYTHONHOME

exec "${HERMES_CLI_BIN}" "$@"
