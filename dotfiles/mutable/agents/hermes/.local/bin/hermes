#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# hermes — Pi 式（editable-checkout）启动 wrapper：runtime 在
# $HERMES_HOME/hermes-agent（hermes-update 生成，不进仓库），首跑 lazy
# bootstrap，启动前 unset PYTHONPATH/PYTHONHOME 防 Guix Python 污染。
# 文档：docs/scripts/hermes.md（布局常量见同包 libexec/hermes-lib.sh）
set -euo pipefail

_bin_dir="$(dirname "$(readlink -f "$0")")"
_libexec_dir="$(dirname "${_bin_dir}")/libexec"
# shellcheck disable=SC1091  # lib 移出 PATH（bin 的兄弟层 libexec/），按 stow 直链的源头 source
source "${_libexec_dir}/hermes-lib.sh"

# 拦截即覆写：上游原生也有 `hermes update|desktop`，此处遮蔽为 Guix 增强版。
# 原生行为经 venv 直调触达：${HERMES_CLI_BIN} update|desktop（libexec 内部
# 本就直调 venv，不经过本 wrapper，无递归）。
case "${1:-}" in
  update) exec "${_libexec_dir}/hermes-update" "${@:2}" ;;
  desktop) exec "${_libexec_dir}/hermes-desktop" "${@:2}" ;;
esac

if [[ ! -x "${HERMES_CLI_BIN}" ]]; then
  if [[ -x "${_libexec_dir}/hermes-update" ]]; then
    echo "Hermes 未安装，执行首次安装..." >&2
    "${_libexec_dir}/hermes-update" || {
      echo "安装失败，见上方错误" >&2
      exit 1
    }
  else
    echo "hermes-update 未找到，无法引导安装（期望位于 ${_libexec_dir}/hermes-update）" >&2
    exit 1
  fi
fi

unset PYTHONPATH
unset PYTHONHOME

exec "${HERMES_CLI_BIN}" "$@"
