#!/usr/bin/env bash
# hermes-install — 在 distrobox 容器内安装/更新 hermes，并把 gateway 交给宿主 shepherd。
#
# 为什么需要这一层：容器内没有 init，`hermes gateway install` 装的 systemd/launchd
# 单元在这里必然失败，gateway 只能以前台进程身份常驻。安装/更新完成后由
# adhoc-services 写入服务定义，交给宿主 shepherd 守护；容器或 hermes 不存在时
# 目录里没有定义，shepherd 侧什么都不会发生。
#
# 用法：
#   hermes-install                  # hermes update（默认）
#   hermes-install --branch main    # 透传给 hermes update
#   hermes-install --setup          # 首次安装：跑容器内 setup-hermes.sh
#   hermes-install --service-only   # 跳过安装，只把 gateway 交给 shepherd
set -euo pipefail

container=my-distrobox
hermes_bin=/home/brokenshine/.local/bin/hermes
setup_script=/home/brokenshine/.hermes/hermes-agent/setup-hermes.sh

run_in_container() {
    distrobox enter --no-tty "$container" -- "$@"
}

# 安装或更新
case "${1:-}" in
    --service-only)
        shift
        ;;
    --setup)
        shift
        run_in_container "$setup_script" "$@"
        ;;
    *)
        run_in_container "$hermes_bin" update "$@"
        ;;
esac

# 更新可能换掉 gateway 入口或目录。先停掉手动实例（update 也可能把它拉起来），
# 再交给 shepherd 独占管理，避免两份 gateway 抢同一批消息渠道。
run_in_container "$hermes_bin" gateway stop >/dev/null 2>&1 || true

# gateway 服务定义以包内 .local/share/adhoc-services/hermes-gateway.scm 为唯一来源
# （含 resolv.conf 等待、容器证书路径、pid 锁清理三层处理）。这里不再内嵌模板，
# 否则重装会把调好的定义覆盖回简化版。
service_def="${XDG_DATA_HOME:-$HOME/.local/share}/adhoc-services/hermes-gateway.scm"
if [ ! -f "$service_def" ]; then
    printf 'hermes-install: 缺少服务定义 %s\n' "$service_def" >&2
    exit 1
fi
adhoc-services enable hermes-gateway < "$service_def"

printf 'hermes-gateway 已交给 shepherd；查看状态：herd status hermes-gateway\n'
