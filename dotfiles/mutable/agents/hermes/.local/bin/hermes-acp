# Hermes Agent — ACP launcher.
# ACP hosts (Zed, JetBrains, Buzz) resolve the agent by this
# command name on the login-shell PATH.
#
# 历史上由 `hermes update` 写入 ~/.local/bin/（硬编码绝对路径）；现已收编
# 进本仓库随 stow 部署。若 update 流程将来重写此文件，请在 restow 后核对
# 软链未被真身覆盖。
exec "$(dirname "$(readlink -f "$0")")/hermes" acp "$@"
