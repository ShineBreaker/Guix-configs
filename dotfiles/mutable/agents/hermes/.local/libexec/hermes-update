#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# hermes-update — `hermes update` 子命令实体（bin/hermes 分发进入，也可按
# libexec 路径直调）：首次安装 + 已装更新。已装路径委托官方 `hermes update`，
# 本脚本只补官方做不了的 Guix 侧四件事：首装、停旧 gateway、uv 隔离、herd 收尾。
# 委托用普通调用而非 exec——成功后还要跑 herd 收尾。
# 文档：docs/scripts/hermes.md（uv 隔离与布局约定见 §hermes update 与 §managed-node）
set -euo pipefail

REPO_URL="https://github.com/NousResearch/hermes-agent.git"
PYTHON_VERSION="3.11" # 与上游 install.sh 的 PYTHON_VERSION 一致

_bin_dir="$(dirname "$(readlink -f "$0")")"
# shellcheck disable=SC1091  # 本脚本已与 lib 同居 libexec/，按 stow 直链的源头 source
source "${_bin_dir}/hermes-lib.sh"

# 重启顺序 backend → gateway（gateway 依赖 backend）
HERMES_HERD_SERVICES=(hermes-backend hermes-gateway)

check_deps() {
  command -v uv >/dev/null 2>&1 || {
    echo "uv 未安装（Guix: guix install uv 或走 nix profile）" >&2
    exit 1
  }
  command -v git >/dev/null 2>&1 || {
    echo "git 未安装（Guix: guix install git）" >&2
    exit 1
  }
}

# bootstrap 标记是 desktop 壳 isBootstrapComplete() 的检查目标：必须是
# schemaVersion=1 + pinnedCommit 的合法 JSON，否则壳回退跑官方 install.sh
_write_bootstrap_marker() {
  local pinned branch
  pinned="$(git -C "${HERMES_CHECKOUT}" rev-parse --short=7 HEAD 2>/dev/null || echo unknown)"
  # 首装都是 main（--branch main），pinnedBranch 记录实际分支名
  branch="$(git -C "${HERMES_CHECKOUT}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  cat >"${HERMES_RUNTIME}/.hermes-bootstrap-complete" <<EOF
{
  "schemaVersion": 1,
  "pinnedCommit": "${pinned}",
  "pinnedBranch": "${branch}",
  "completedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "desktopVersion": "built-locally"
}
EOF
}

# 收尾必须是 停→清野实例→enable+start，不是简单 restart：官方 update 会
# 自己拉起脱离 shepherd 的野实例，两侧抢端口+singleton lock 触发 respawn
# 循环直至服务被 shepherd 禁用。事故细节见 docs/scripts/hermes.md §hermes update。
_restart_herd_services() {
  if ! command -v herd >/dev/null 2>&1; then
    echo "  ⚠ herd 未找到，跳过常驻服务重启（手动: herd restart ${HERMES_HERD_SERVICES[*]}）"
    return 0
  fi
  echo "→ 恢复 herd 管理的 hermes 服务（加载新代码）..."
  # 先停：respawn? #t 的服务不 stop 就会一边被官方接管一边被 shepherd 拉起
  for _svc in "${HERMES_HERD_SERVICES[@]}"; do
    herd stop "${_svc}" >/dev/null 2>&1 || true
  done
  sleep 1
  # gateway 按 argv 可辨（官方走 python -m hermes_cli.main，shepherd 走 venv/bin/hermes）；
  # dashboard 两侧 argv 相同但此时 shepherd 侧已停，剩下的必是野实例
  pkill -f 'hermes_cli\.main gateway run' >/dev/null 2>&1 || true
  pkill -f 'hermes dashboard --no-open' >/dev/null 2>&1 || true
  sleep 2
  for _svc in "${HERMES_HERD_SERVICES[@]}"; do
    # crash-loop 过的话服务可能已被 shepherd 自动禁用，enable 一次保证 start 能生效
    herd enable "${_svc}" >/dev/null 2>&1 || true
    herd start "${_svc}" >/dev/null 2>&1 \
      && echo "  ✓ ${_svc} 已重启" \
      || echo "  ⚠ ${_svc} 重启失败（手动: herd start ${_svc}）"
  done
}

# managed Node 树（$HERMES_HOME/node）：root package.json 的 engines.npm 约束
# 很窄，Guix npm 可能卡禁止区间 → backend web build EBADENGINE → crash-loop。
# 不能依赖官方 ensure_node——它只查 node 版本不查 npm 版本（本次故障正卡在 npm）。
# HERMES_NODE_SKIP_LINKS=1：不软链到 ~/.local/bin，避免 shadow Guix toolchain。
# 背景见 docs/scripts/hermes.md §managed-node。
_ensure_managed_node() {
  local _node_bin="${HERMES_HOME}/node/bin/node"
  if [[ -x "${_node_bin}" ]]; then
    return 0
  fi
  echo "→ Provisioning Hermes-managed Node 树到 ${HERMES_HOME}/node ..."
  local _bootstrap="${HERMES_RUNTIME}/scripts/lib/node-bootstrap.sh"
  if [[ ! -f "${_bootstrap}" ]]; then
    echo "  ⚠ node-bootstrap.sh 未找到（${_bootstrap}），跳过 managed node provision" >&2
    echo "    backend 若 crash-loop，手动跑: source ${_bootstrap} && HERMES_NODE_SKIP_LINKS=1 _nb_install_bundled_node" >&2
    return 0
  fi
  # shellcheck disable=SC1090  # checkout 内脚本，按源头源
  if HERMES_NODE_SKIP_LINKS=1 bash -c "source '${_bootstrap}' && _nb_install_bundled_node"; then
    echo "  ✓ managed node 已 provision（$("${_node_bin}" --version 2>/dev/null || echo '版本未知')）"
  else
    echo "  ⚠ managed node provision 失败，backend web build 可能失败" >&2
  fi
}

# hicolor 图标：仓库只给 1024px 源图，面板请求小尺寸解析失败 → 批量生成。
# 幂等：sentinel 尺寸存在即跳过（强刷：删 hicolor/*/apps/hermes.png 重跑）。
_install_hicolor_icon() {
  local _icon_src="${HERMES_CHECKOUT}/apps/desktop/assets/icon.png"
  local _hicolor="${HERMES_HICOLOR_ROOT}" # XDG_DATA_HOME 默认值解析收敛在 lib
  local _sentinel="${_hicolor}/48x48/apps/hermes.png"

  [[ -f "${_sentinel}" ]] && return 0

  if [[ ! -f "${_icon_src}" ]]; then
    echo "  ⚠ 图标源缺失（${_icon_src}），跳过图标生成" >&2
    return 0
  fi
  if ! python3 -c 'import PIL' >/dev/null 2>&1; then
    echo "  ⚠ Pillow 不可用，跳过图标生成（python3 -m pip install Pillow）" >&2
    return 0
  fi

  echo "→ 生成 hicolor 桌面图标（源: ${_icon_src##*/}）..."
  if python3 - "${_icon_src}" "${_hicolor}" <<'PYEOF'; then
import sys, os
from PIL import Image
try:
    resample = Image.Resampling.LANCZOS
except AttributeError:          # Pillow < 9.1
    resample = Image.LANCZOS
src, hicolor = sys.argv[1], sys.argv[2]
img = Image.open(src).convert("RGBA")
for s in (16, 32, 48, 128, 256, 512):
    d = os.path.join(hicolor, "%dx%d/apps" % (s, s))
    os.makedirs(d, exist_ok=True)
    img.resize((s, s), resample).save(os.path.join(d, "hermes.png"))
PYEOF
    echo "  ✓ hicolor 图标已生成（16/32/48/128/256/512）"
  else
    echo "  ⚠ 图标生成失败" >&2
  fi
}

# --- 路径 A：首次安装（官方 update 在 checkout 不存在时直接报错退出，故自办） ---
first_install() {
  echo "首次安装 Hermes Agent（clone main + uv 自管 Python ${PYTHON_VERSION}）..."
  mkdir -p "${HERMES_RUNTIME}"
  git clone --depth 1 --branch main "${REPO_URL}" "${HERMES_CHECKOUT}"

  # 必须用 uv 自管 Python：Guix profile python 的 store 路径会被升级/gc 换掉，
  # venv 软链随之失效；uv 自管树路径稳定不被 gc
  echo "确保 uv 自管 Python ${PYTHON_VERSION}..."
  uv python install "${PYTHON_VERSION}"

  echo "创建 venv (uv 自管 Python ${PYTHON_VERSION})..."
  uv venv "${HERMES_VENV}" --python "${PYTHON_VERSION}"

  # 钉死 UV_PYTHON 到本 venv：防继承的 UV_PYTHON 让 uv 把 venv 重建到别的 python 版本
  export UV_PYTHON="${HERMES_VENV}/bin/python"
  export VIRTUAL_ENV="${HERMES_VENV}"

  # 分层安装（对齐上游 install.sh）：uv.lock 哈希校验 → PyPI 重解析 → 基础安装兜底
  cd "${HERMES_CHECKOUT}"
  if [[ -f uv.lock ]] && UV_PROJECT_ENVIRONMENT="${HERMES_VENV}" uv sync --extra all --locked; then
    echo "依赖安装完成（hash-verified via uv.lock）"
  else
    [[ -f uv.lock ]] && echo "  uv.lock sync 失败，降级到 PyPI 解析..." >&2
    if ! uv pip install -e "${HERMES_CHECKOUT}[all]"; then
      echo "  [all] 安装失败，降级到基础安装..." >&2
      uv pip install -e "${HERMES_CHECKOUT}"
    fi
  fi

  _write_bootstrap_marker

  _ensure_managed_node

  _install_hicolor_icon

  "${HERMES_VENV}/bin/hermes" --version
  echo ""
  echo "首次安装完成。"
  echo "  Web UI:  hermes serve / hermes dashboard"
  echo "  TUI:     直接运行 hermes"
  echo "  Desktop: hermes desktop（Electron）"
  return 0
}

# --- 路径 B：已安装 → 委托官方 `hermes update` ---
update_existing() {
  echo "已安装，委托官方 \`hermes update\` 更新（透传参数: $*）..."

  # 停旧 gateway：其进程内模块路径指向更新前 checkout，pull 后必失效；
  # 失败忽略（没在跑/venv 已坏）。shepherd respawn 出的新实例由收尾统一处理。
  if [[ -x "${HERMES_VENV}/bin/hermes" ]]; then
    "${HERMES_VENV}/bin/hermes" gateway stop >/dev/null 2>&1 || true
  fi

  # uv 隔离：官方 ensure_uv 只看 $HERMES_HOME/bin/uv 是否存在，缺了就从
  # astral.sh 下载独立 uv 无视系统 uv。预置指向系统 uv 的 symlink（is_file
  # follow symlink → 官方直接用），profile 路径比 store hash 稳定。
  _uv_managed="${HERMES_HOME}/bin/uv"
  _uv_system="$(command -v uv)"
  if [[ -n "${_uv_system}" ]] && [[ ! -e "${_uv_managed}" ]]; then
    mkdir -p "${HERMES_HOME}/bin"
    ln -s "${_uv_system}" "${_uv_managed}"
    echo "  uv 隔离: ${_uv_managed} -> ${_uv_system}（阻止官方下载独立 managed uv）"
  fi

  _ensure_managed_node

  _install_hicolor_icon

  _head_before="$(git -C "${HERMES_CHECKOUT}" rev-parse HEAD 2>/dev/null || true)"
  _update_rc=0
  "${HERMES_VENV}/bin/hermes" update "$@" || _update_rc=$?
  _head_after="$(git -C "${HERMES_CHECKOUT}" rev-parse HEAD 2>/dev/null || true)"

  _is_check=0
  for _a in "$@"; do [[ "$_a" == "--check" ]] && _is_check=1; done

  # 收尾判据是「HEAD 是否变了」而非官方退出码：updater 收尾步骤自己可能
  # ImportError 崩（进程内 sys.modules 还是旧代码），此时退出码非 0 但代码
  # 已更新——继续收尾；HEAD 未变才是真失败。详见 docs/scripts/hermes.md §实现与约束。
  if [[ "${_update_rc}" -ne 0 ]]; then
    if [[ "${_head_before}" == "${_head_after}" ]]; then
      echo "✗ 官方 update 失败（退出码 ${_update_rc}），代码未变化，未重启服务" >&2
      exit "${_update_rc}"
    fi
    echo "⚠ 官方 update 非零退出（${_update_rc}），但代码已更新（${_head_before:0:7} → ${_head_after:0:7}）" >&2
    echo "  多为 updater 自身收尾步骤失败，继续执行本地收尾..." >&2
  fi

  if [[ "${_is_check}" -eq 1 ]]; then
    # --check 只读探测，不改文件，无需重启
    exit 0
  fi

  _restart_herd_services

  echo ""
  echo "✓ 更新完成，常驻服务已重启加载新代码。"
  echo "  ⚠ 已开的 TUI 会话 / desktop 窗口持旧代码，需手动重开。"
}

main() {
  check_deps
  if [[ ! -d "${HERMES_CHECKOUT}/.git" ]]; then
    first_install
  else
    update_existing "$@"
  fi
}

main "$@"
