{
  "language_models": {
    "opencode": {
      "show_zen_models": false
    }
  },
  "proxy": "",
  "ui_font_family": "Sarasa UI SC",
  "buffer_font_family": "Maple Mono NF CN",
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "fable"
      },
      "type": "registry"
    }
  },
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Colorizer"
  },
  "active_pane_modifiers": {
    "border_size": 2.0,
    "inactive_opacity": 0.8
  },
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "model_parameters": [],
    "play_sound_when_agent_done": "when_hidden",
    "tool_permissions": {
      "default": "allow"
    }
  },
  "auto_install_extensions": {
    "basher": true,
    "catppuccin-icons": true,
    "colorizer": true,
    "csharp": true,
    "git-firefly": true,
    "html": true,
    "java": true,
    "kdl": true,
    "log": true,
    "make": true,
    "neocmake": true,
    "nix": true,
    "python": true,
    "scheme": true,
    "scss": true,
    "snippets": true,
    "toml": true
  },
  "auto_signature_help": true,
  "auto_update": false,
  "autosave": "on_focus_change",
  "autoscroll_on_clicks": false,
  "base_keymap": "VSCode",
  "buffer_font_size": 14,
  "buffer_font_weight": 400.0,
  "collaboration_panel": {
    "button": false
  },
  "current_line_highlight": "all",
  "cursor_shape": "bar",
  "diagnostics": {
    "inline": {
      "enabled": true
    },
    "lsp_pull_diagnostics": {
      "debounce_ms": 100
    }
  },
  "disable_ai": false,
  "format_on_save": "on",
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "delay_ms": 2000,
      "enabled": true,
      "show_commit_summary": true
    }
  },
  "git_panel": {
    "tree_view": true,
    "button": true,
    "dock": "left"
  },
  "icon_theme": "Catppuccin Frappé",
  "inlay_hints": {
    "enabled": true,
    "show_background": false
  },
  "languages": {
    "C": {
      "language_servers": ["ccls"],
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "/gnu/store/rkdhldcc4vjhy1c6mb6kxbpl1hk0vd4m-clang-23.1.1/bin/clang-format",
          "arguments": ["-style=file", "-assume-filename={buffer_path}"]
        }
      }
    },
    "C++": {
      "language_servers": ["ccls"],
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "/gnu/store/rkdhldcc4vjhy1c6mb6kxbpl1hk0vd4m-clang-23.1.1/bin/clang-format",
          "arguments": ["-style=file", "-assume-filename={buffer_path}"]
        }
      }
