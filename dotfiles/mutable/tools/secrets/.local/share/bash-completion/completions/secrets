# secrets 命令补全（bash）
_secrets() {
	local cur prev
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD - 1]}"
	local cmds="init list add encrypt decrypt show clip get env set edit rename remove clean recipients re-encrypt menu"
	if [[ $COMP_CWORD -eq 1 ]]; then
		COMPREPLY=($(compgen -W "--dry-run $cmds" -- "$cur"))
		return
	fi
	case "$prev" in
	decrypt | show | clip | get | env | set | edit | add | rename | remove)
		COMPREPLY=($(compgen -W "$(secrets __names 2>/dev/null)" -- "$cur"))
		;;
	esac
}
complete -F _secrets secrets
