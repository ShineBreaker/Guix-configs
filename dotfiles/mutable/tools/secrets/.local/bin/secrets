#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT

# secrets — 基于 age 的本地密钥加密助手（明文只进 tmpfs，密文随仓库分发）
# 文档：docs/secrets.md

set -euo pipefail

# 全局 dry-run 开关：1 时所有写副作用命令只打印计划不执行
DRY_RUN=0

# 以真实路径反推仓库根；脱离仓库结构时回退 git 探测。
_self="$(readlink -f "${BASH_SOURCE[0]}")"
case "$_self" in
  */dotfiles/mutable/tools/secrets/.local/bin/secrets)
    REPO_ROOT="${_self%/dotfiles/mutable/tools/secrets/.local/bin/secrets}"
    ;;
  *)
    REPO_ROOT="$(git -C "$(dirname "$_self")" rev-parse --show-toplevel 2>/dev/null || true)"
    ;;
esac
if [[ -z "$REPO_ROOT" ]]; then
  echo "错误: 无法定位仓库根（脚本应位于 dotfiles/mutable/tools/secrets/.local/bin/）" >&2
  exit 1
fi

SECRETS_ROOT="$REPO_ROOT/dotfiles/mutable/tools/secrets/.local/share"
KEY_DIR="$SECRETS_ROOT/keys"                  # age（私钥，gitignore）与 *.pub（公钥，入库）
SECRETS_DIR="$SECRETS_ROOT/secrets-encrypted" # 密文入库目录
# 明文只进 tmpfs：随会话消失，不写持久盘
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
DECRYPT_DIR="$RUNTIME_DIR/secrets-decrypted"
LEGACY_DECRYPT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/secrets-decrypted"
CLIP_TTL="${SECRETS_CLIP_TTL:-45}"

die() {
  echo "错误: $*" >&2
  exit 1
}

# dry-run 守卫：被拦截时打印计划并返回 0（调用方 `plan ... && return 0/continue`）
plan() {
  [[ $DRY_RUN -eq 1 ]] && {
    echo "[dry-run] $*" >&2
    return 0
  }
  return 1
}

# 条目名白名单：防路径穿越（name 会拼进 SECRETS_DIR/DECRYPT_DIR）
valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || {
    echo "错误: 非法条目名 '$1'（只允许 A-Z a-z 0-9 . _ -）" >&2
    return 1
  }
}

# 校验 $1 是合法条目名；为空时打印 $2 用法提示并退出
require_name() {
  if [[ -z "${1:-}" ]]; then
    printf '%s\n' "$2" >&2
    exit 1
  fi
  valid_name "$1" || exit 1
}

# 列出所有条目名（去 .age 后缀），供菜单与补全
list_names() {
  [[ -d "$SECRETS_DIR" ]] || return 0
  find "$SECRETS_DIR" -maxdepth 1 -name '*.age' -printf '%f\n' 2>/dev/null \
    | sed 's/\.age$//' | sort
}

# 列出密文文件的绝对路径（排序），cmd_list 与 cmd_re_encrypt 共用
list_ciphers() {
  [[ -d "$SECRETS_DIR" ]] || return 0
  find "$SECRETS_DIR" -maxdepth 1 -name '*.age' -print 2>/dev/null | sort
}

# 私钥候选路径，按优先级排列（每行一个；env 覆盖 > stow 部署位 > 仓库源）
privkey_candidates() {
  printf '%s\n' \
    "${SECRETS_PRIVATE_KEY:-}" \
    "$HOME/.local/share/keys/age" \
    "$KEY_DIR/age"
}

find_default_pubkey() {
  if [[ -n "${SECRETS_PUBLIC_KEY:-}" && -f "${SECRETS_PUBLIC_KEY}" ]]; then
    echo "${SECRETS_PUBLIC_KEY}"
    return
  fi
  [[ -f "$KEY_DIR/age.pub" ]] && {
    echo "$KEY_DIR/age.pub"
    return
  }
  # 退化：任意 .pub
  local f
  f=$(find "$KEY_DIR" -maxdepth 1 -name '*.pub' -print -quit 2>/dev/null || true)
  [[ -n "$f" ]] && {
    echo "$f"
    return
  }
  return 1
}

find_default_privkey() {
  local p
  while IFS= read -r p; do
    [[ -n "$p" && -f "$p" ]] && {
      echo "$p"
      return
    }
  done < <(privkey_candidates)
  return 1
}

require_age() {
  if ! command -v age >/dev/null 2>&1; then
    die "找不到 age 命令。请先 just home 安装 age 包。"
  fi
}

# 解密到 stdout：校验名称 + 找私钥 + 查密文；各 cmd_* 共用
decrypt_to_stdout() {
  require_age
  local name="$1"
  valid_name "$name" || exit 1
  local priv
  priv=$(find_default_privkey) || {
    echo "错误: 找不到私钥。" >&2
    echo "  候选路径: \$SECRETS_PRIVATE_KEY, ~/.local/share/keys/age, $KEY_DIR/age" >&2
    echo "  若 stow 未部署，跑：cd $REPO_ROOT && blue stow tools/secrets" >&2
    exit 1
  }
  local cipher="$SECRETS_DIR/$name.age"
  [[ -f "$cipher" ]] || die "密文不存在: $cipher"
  age -d -i "$priv" "$cipher"
}

# 解密条目到内存临时工作目录并回显路径；<dir>/plaintext 是工作副本，
# 密文不存在时为空文件（新建条目路径）。调用方负责 rm -rf 该目录。
decrypt_to_workdir() {
  local name="$1" cipher="$SECRETS_DIR/$1.age" workdir
  workdir=$(mktmpdir)
  if [[ -f "$cipher" ]]; then
    age -d -i "$(find_default_privkey)" "$cipher" >"$workdir/plaintext"
  else
    : >"$workdir/plaintext"
  fi
  echo "$workdir"
}

# 合并 KEY_DIR 所有 .pub 为 recipients 文件并回显路径；无公钥时返回 1
collect_recipients() {
  local recipients_file
  recipients_file=$(mktemp)
  local f
  for f in "$KEY_DIR"/*.pub; do
    [[ -f "$f" ]] || continue
    cat "$f" >>"$recipients_file"
  done
  if [[ ! -s "$recipients_file" ]]; then
    rm -f "$recipients_file"
    return 1
  fi
  echo "$recipients_file"
}

# 内存临时目录（edit/set 用）：明文不碰持久盘——优先 XDG_RUNTIME_DIR(tmpfs)，退 /dev/shm
mktmpdir() {
  mktemp -d "$RUNTIME_DIR/secrets-edit.XXXXXX" 2>/dev/null \
    || mktemp -d /dev/shm/secrets-edit.XXXXXX
}

cmd_init() {
  require_age
  if [[ -f "$KEY_DIR/age" ]]; then
    echo "已存在: $KEY_DIR/age"
    echo "如需覆盖请先 trash 现有私钥。"
    return 1
  fi
  # 安全不变量：私钥落盘前先确认 git 会忽略它，.gitignore 失配则拒绝生成
  if (cd "$REPO_ROOT" && ! git check-ignore -q "$KEY_DIR/age"); then
    echo "✗ $KEY_DIR/age 不在 .gitignore 覆盖范围内，拒绝生成（防私钥入库）。" >&2
    echo "  请先在 .gitignore 加规则：dotfiles/mutable/tools/secrets/.local/share/keys/age" >&2
    return 1
  fi
  plan "init: 生成密钥对 → $KEY_DIR/age + $KEY_DIR/age.pub" && return 0

  mkdir -p "$KEY_DIR" "$SECRETS_DIR"

  local priv="$KEY_DIR/age"
  local pub="$KEY_DIR/age.pub"
  age-keygen -o "$priv" 2>&1
  chmod 600 "$priv"

  # 从私钥首行注释提取公钥
  awk '/^# public key:/ {print $NF}' "$priv" >"$pub"
  chmod 644 "$pub"

  echo ""
  echo "✓ 私钥: $priv（不入 git）"
  echo "✓ 公钥: $pub（会进 git）"
  echo ""
  echo "下一步："
  echo "  1. cd $REPO_ROOT && blue stow tools/secrets   # 部署私钥与 secrets 命令"
  echo "  2. secrets add <name>                  # 交互式新建条目"
}

cmd_list() {
  echo "== 公钥（$KEY_DIR/）=="
  if [[ -d "$KEY_DIR" ]]; then
    local pub found_pub=0
    for pub in "$KEY_DIR"/*.pub; do
      [[ -f "$pub" ]] || continue
      printf "  %s\n" "$pub"
      found_pub=1
    done
    [[ $found_pub -eq 0 ]] && echo "(无)"
  else
    echo "(目录不存在)"
  fi
  echo ""
  echo "== 私钥状态 =="
  local found=0 p
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    if [[ -f "$p" ]]; then
      local mode
      mode=$(stat -Lc '%a' "$p" 2>/dev/null || stat -f '%Lp' "$p")
      echo "  ✓ $p (mode=$mode)"
      found=1
    fi
  done < <(privkey_candidates)
  [[ $found -eq 0 ]] && echo "  (未找到任何私钥；先跑 init 或部署 stow secrets)"
  echo ""
  echo "== 密文清单（$SECRETS_DIR/*.age）=="
  if [[ -d "$SECRETS_DIR" ]]; then
    local ciphers=() f
    while IFS= read -r f; do
      ciphers+=("$f")
    done < <(list_ciphers)
    if ((${#ciphers[@]} == 0)); then
      echo "  (无)"
    else
      for f in "${ciphers[@]}"; do
        local sz
        sz=$(stat -c '%s' "$f" 2>/dev/null || echo "?")
        printf "  %-40s %s bytes\n" "$f" "$sz"
      done
    fi
  else
    echo "(目录不存在)"
  fi
  echo ""
  echo "== 已解密的明文（$DECRYPT_DIR，tmpfs）=="
  if [[ -d "$DECRYPT_DIR" ]]; then
    local plains=()
    while IFS= read -r f; do
      plains+=("$f")
    done < <(find "$DECRYPT_DIR" -maxdepth 1 -type f -print 2>/dev/null | sort)
    if ((${#plains[@]} == 0)); then
      echo "  (无)"
    else
      printf '  %s\n' "${plains[@]##*/}"
    fi
  else
    echo "(目录不存在，跑一次 decrypt 会自动创建)"
  fi
  # 旧持久盘明文残留提醒
  if [[ -d "$LEGACY_DECRYPT_DIR" ]] \
    && [[ -n "$(find "$LEGACY_DECRYPT_DIR" -maxdepth 1 -type f -print -quit 2>/dev/null)" ]]; then
    echo ""
    echo "⚠ 旧明文目录仍有残留: $LEGACY_DECRYPT_DIR（secrets clean 可清除）"
  fi
}

cmd_recipients() {
  if [[ ! -d "$KEY_DIR" ]]; then
    die "无公钥目录: $KEY_DIR"
  fi
  local f found=0
  for f in "$KEY_DIR"/*.pub; do
    [[ -f "$f" ]] || continue
    echo "# $(basename "$f")"
    cat "$f"
    echo ""
    found=1
  done
  if [[ $found -eq 0 ]]; then
    echo "(无 .pub 文件)"
  fi
}

cmd_encrypt() {
  require_age
  local name="${1:-}"
  require_name "$name" "用法: secrets encrypt <name>
  从 stdin 读明文，写到 secrets-encrypted/<name>.age"
  local pub
  if ! pub=$(find_default_pubkey); then
    die "找不到公钥。先跑 secrets init。"
  fi

  mkdir -p "$SECRETS_DIR"
  local out="$SECRETS_DIR/$name.age"
  if [[ -f "$out" ]]; then
    echo "警告: $out 已存在，将覆盖。" >&2
  fi

  local recipients_file
  if ! recipients_file=$(collect_recipients); then
    die "$KEY_DIR 里没有任何公钥。"
  fi
  # shellcheck disable=SC2064  # 必须布防时展开：局部变量在 EXIT 时已销毁
  trap "rm -f '$recipients_file'" EXIT

  plan "encrypt: stdin → $out (recipients from $KEY_DIR)" && return 0
  age -R "$recipients_file" -o "$out"
  chmod 644 "$out"
  local sz
  sz=$(stat -c '%s' "$out" 2>/dev/null || stat -f '%z' "$out")
  echo "✓ 写入 $out ($sz bytes)，recipients: $(tr '\n' ' ' <"$recipients_file" | sed 's/ $//')"
}

cmd_decrypt() {
  local name="${1:-}"
  local to_stdout=0
  [[ "${2:-}" == "--stdout" ]] && to_stdout=1

  require_name "$name" "用法: secrets decrypt <name> [--stdout]"

  if [[ $to_stdout -eq 1 ]]; then
    decrypt_to_stdout "$name"
    return
  fi

  local cipher="$SECRETS_DIR/$name.age"
  local out="$DECRYPT_DIR/$name"
  if [[ -f "$out" ]]; then
    echo "警告: $out 已存在，将覆盖。" >&2
  fi
  plan "decrypt: $cipher → $out" && return 0
  mkdir -p "$DECRYPT_DIR"
  chmod 700 "$DECRYPT_DIR"
  # 先 mktemp(600) 再 mv：消除「建文件→chmod」之间的明文权限窗口
  local tmp
  tmp=$(mktemp "$DECRYPT_DIR/.tmp.XXXXXX")
  if decrypt_to_stdout "$name" >"$tmp"; then
    mv "$tmp" "$out"
    echo "✓ 解密到 $out"
  else
    rm -f "$tmp"
    exit 1
  fi
}

cmd_show() {
  cmd_decrypt "$1" --stdout
}

cmd_clip() {
  local name="${1:-}"
  require_name "$name" "用法: secrets clip <name>"
  if ! command -v wl-copy >/dev/null 2>&1; then
    die "找不到 wl-copy（wl-clipboard）"
  fi
  local plain
  plain=$(decrypt_to_stdout "$name")
  printf '%s' "$plain" | wl-copy
  echo "✓ 已复制 '$name' 到剪贴板（${CLIP_TTL}s 后自动清空）"
  # 后台定时清空必须与脚本退出解耦，否则调用进程结束时剪贴板残留明文
  (sleep "$CLIP_TTL" && wl-copy --clear) </dev/null >/dev/null 2>&1 &
  disown
}

cmd_get() {
  local name="${1:-}" key="${2:-}"
  if [[ -z "$name" || -z "$key" ]]; then
    echo "用法: secrets get <name> <KEY>" >&2
    echo "  提取 KEY=\"value\" 型条目的单字段值" >&2
    exit 1
  fi
  decrypt_to_stdout "$name" \
    | awk -F= -v k="$key" '$1==k {sub(/^[^=]*=/,""); gsub(/^"|"$/,""); print; exit}'
}

cmd_env() {
  local name="${1:-}"
  require_name "$name" "用法: eval \"\$(secrets env <name>)\""
  decrypt_to_stdout "$name" | grep -vE '^\s*(#|$)' | sed 's/^/export /'
}

cmd_set() {
  local name="${1:-}" key="${2:-}" value="${3:-}"
  if [[ -z "$name" || -z "$key" ]]; then
    echo "用法: secrets set <name> <KEY> <value>" >&2
    echo "  改/加一条 KEY=\"value\" 行（无需开编辑器）" >&2
    exit 1
  fi
  valid_name "$name" || exit 1
  if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    die "KEY '$key' 不是合法的变量名"
  fi
  local cipher="$SECRETS_DIR/$name.age"
  # 密文已存在就要先解密回写；没私钥时明确报错，避免空串进 `age -d -i ""` 的费解失败
  if [[ -f "$cipher" ]] && ! find_default_privkey >/dev/null; then
    die "密文已存在但找不到私钥，无法解密更新: $cipher"
  fi

  plan "set: $name $key=***（更新 $cipher）" && return 0

  local tmpdir tmp
  tmpdir=$(decrypt_to_workdir "$name")
  trap '[[ -n "${tmpdir:-}" ]] && rm -rf "$tmpdir"' RETURN INT TERM
  tmp="$tmpdir/plaintext"
  awk -F= -v k="$key" -v v="$value" '
		BEGIN { gsub(/"/, "\\\"", v) }
		$1 == k { if (!done) printf "%s=\"%s\"\n", k, v; done=1; next }
		{ print }
		END { if (!done) printf "%s=\"%s\"\n", k, v }
	' "$tmp" >"$tmp.new" && mv "$tmp.new" "$tmp"

  cmd_encrypt "$name" <"$tmp"
  echo "✓ $name: $key 已更新"
}

cmd_edit() {
  local name="${1:-}"
  require_name "$name" "用法: secrets edit <name>"
  : "${EDITOR:=nano}"
  if ! command -v "$EDITOR" >/dev/null 2>&1; then
    die "EDITOR='$EDITOR' 不可用"
  fi

  local cipher="$SECRETS_DIR/$name.age"
  find_default_privkey >/dev/null || die "找不到私钥"

  plan "edit: $name（解密 → $EDITOR → 回写密文）" && return 0

  local tmpdir tmp
  [[ -f "$cipher" ]] || echo "提示: $cipher 不存在，将从空模板开始。" >&2
  tmpdir=$(decrypt_to_workdir "$name")
  trap '[[ -n "${tmpdir:-}" ]] && rm -rf "$tmpdir"' RETURN INT TERM
  tmp="$tmpdir/plaintext"

  if ! "$EDITOR" "$tmp"; then
    die "编辑器退出码非零，未写回密文。"
  fi

  if [[ ! -s "$tmp" ]] && [[ ! -f "$cipher" ]]; then
    echo "未修改（空文件），未生成密文。" >&2
    exit 1
  fi

  cmd_encrypt "$name" <"$tmp"
}

cmd_rename() {
  local old="${1:-}" new="${2:-}"
  if [[ -z "$old" || -z "$new" ]]; then
    echo "用法: secrets rename <old> <new>" >&2
    exit 1
  fi
  valid_name "$old" || exit 1
  valid_name "$new" || exit 1
  local src="$SECRETS_DIR/$old.age" dst="$SECRETS_DIR/$new.age"
  [[ -f "$src" ]] || die "密文不存在: $src"
  [[ -f "$dst" ]] && die "目标已存在: $dst"
  plan "rename: $src → $dst" && return 0
  mv "$src" "$dst"
  [[ -f "$DECRYPT_DIR/$old" ]] && mv "$DECRYPT_DIR/$old" "$DECRYPT_DIR/$new"
  echo "✓ $old → $new（git 里记得 add 新密文）"
}

cmd_remove() {
  local name="${1:-}"
  require_name "$name" "用法: secrets remove <name>"
  local cipher="$SECRETS_DIR/$name.age"
  [[ -f "$cipher" ]] || die "密文不存在: $cipher"
  echo "将删除密文 $cipher（git 可恢复）及 tmpfs 明文副本。"
  read -r -p "确认？[y/N] " ans
  [[ "$ans" == "y" || "$ans" == "Y" ]] || {
    echo "取消。"
    return 0
  }
  plan "remove: $cipher" && return 0
  rm -f "$cipher" "$DECRYPT_DIR/$name"
  echo "✓ 已删除 $name"
}

cmd_clean() {
  plan "clean: 清空 $DECRYPT_DIR 与 $LEGACY_DECRYPT_DIR" && return 0
  local n=0 d f
  for d in "$DECRYPT_DIR" "$LEGACY_DECRYPT_DIR"; do
    [[ -d "$d" ]] || continue
    while IFS= read -r f; do
      rm -f "$f"
      n=$((n + 1))
    done < <(find "$d" -maxdepth 1 -type f 2>/dev/null)
  done
  echo "✓ 已清空明文缓存（$n 个文件）"
}

cmd_menu() {
  if ! command -v fzf >/dev/null 2>&1; then
    die "找不到 fzf（交互菜单需要它）"
  fi
  local name action
  while true; do
    name=$(list_names | fzf --prompt='secrets> ' --header='条目（Esc 退出）' \
      --preview='secrets list 2>/dev/null | grep -F {}.age' --preview-window=hidden) || break
    action=$(printf '%s\n' \
      show clip get edit env set decrypt rename remove back \
      | fzf --prompt="secrets $name> " --header='动作') || break
    case "$action" in
      back) continue ;;
      show) cmd_show "$name" ;;
      clip) cmd_clip "$name" ;;
      get)
        local key
        key=$(decrypt_to_stdout "$name" | grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' \
          | tr -d '=' | fzf --prompt="$name KEY> ") || continue
        [[ -n "$key" ]] && cmd_get "$name" "$key"
        ;;
      edit) cmd_edit "$name" ;;
      env) cmd_env "$name" ;;
      set)
        local key value
        read -r -p "KEY: " key
        [[ -z "$key" ]] && continue
        read -r -p "value: " value
        cmd_set "$name" "$key" "$value"
        ;;
      decrypt) cmd_decrypt "$name" ;;
      rename)
        local new
        read -r -p "新名称: " new
        [[ -n "$new" ]] && cmd_rename "$name" "$new"
        ;;
      remove) cmd_remove "$name" ;;
    esac
  done
}

cmd_re_encrypt() {
  require_age
  local decrypt_key=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --with)
        [[ $# -lt 2 ]] && die "--with 需要一个参数"
        decrypt_key="$2"
        shift 2
        ;;
      *)
        echo "未知参数: $1" >&2
        echo "用法: secrets re-encrypt [--with <old-private-key>]" >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "$decrypt_key" ]]; then
    if ! decrypt_key=$(find_default_privkey); then
      die "未指定 --with，且默认私钥也不存在。"
    fi
  elif [[ ! -f "$decrypt_key" ]]; then
    die "--with 指定的私钥不存在: $decrypt_key"
  fi

  local pub
  if ! pub=$(find_default_pubkey); then
    die "找不到公钥。"
  fi

  local recipients_file
  if ! recipients_file=$(collect_recipients); then
    die "$KEY_DIR 里没有任何公钥。"
  fi
  # shellcheck disable=SC2064  # 必须布防时展开：局部变量在 EXIT 时已销毁
  trap "rm -f '$recipients_file'" EXIT

  local cipher name
  while IFS= read -r cipher; do
    name="$(basename "$cipher")"
    name="${name%.age}"
    plan "re-encrypt: $name (decrypt: $decrypt_key, encrypt: $pub)" && continue
    # 不变量：解密失败（pipefail）必须中止整个脚本，避免部分轮换后新旧密文混杂
    age -d -i "$decrypt_key" "$cipher" | age -R "$recipients_file" -o "$cipher.tmp" \
      && mv "$cipher.tmp" "$cipher"
    echo "✓ 重加密 $name"
  done < <(list_ciphers)
}

usage() {
  cat <<'EOF'
用法：secrets [--dry-run] <command> [args...]

命令：
  secrets                    交互菜单（fzf 选条目 → 选动作）
  init                       生成 age 密钥对（已存在则拒绝覆盖）
  list                       列出所有 .age 密文 + 密钥/明文状态
  add <name>                 交互式新建条目（= edit，空模板起）
  encrypt <name>             加密 stdin → secrets-encrypted/<name>.age
  decrypt <name>             解密 → tmpfs 明文（可加 --stdout）
  show <name>                解密后 cat 明文（= decrypt --stdout）
  clip <name>                解密 → wl-copy，45s 后自动清空剪贴板
  get <name> <KEY>           提取 KEY="value" 型条目的单字段值
  env <name>                 输出 export 行：eval "$(secrets env <name>)"
  set <name> <KEY> <value>   改/加 KEY="value" 行（无需开编辑器）
  edit <name>                解密到内存临时目录 → $EDITOR → 回写密文
  rename <old> <new>         重命名密文
  remove <name>              删除密文 + tmpfs 明文副本
  clean                      清空 tmpfs 明文目录（含旧路径残留）
  recipients                 列出 keys/ 下所有公钥
  re-encrypt [--with <key>]  用旧私钥解密所有 .age，用当前公钥重加密（轮换）

环境变量：
  SECRETS_PRIVATE_KEY        解密私钥路径（默认 ~/.local/share/keys/age）
  SECRETS_PUBLIC_KEY         加密公钥路径（默认仓库 keys/age.pub）
  SECRETS_CLIP_TTL           clip 自动清空秒数（默认 45）
  EDITOR                     edit 子命令用

全局选项：
  --dry-run                  只打印将执行的操作，不实际写盘（须置于命令之前）
EOF
}

main() {
  if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN=1
    shift
  fi
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    list | ls) cmd_list "$@" ;;
    recipients) cmd_recipients "$@" ;;
    encrypt) cmd_encrypt "$@" ;;
    decrypt) cmd_decrypt "$@" ;;
    show) cmd_show "$@" ;;
    clip) cmd_clip "$@" ;;
    get) cmd_get "$@" ;;
    env) cmd_env "$@" ;;
    set) cmd_set "$@" ;;
    add | edit) cmd_edit "$@" ;;
    rename) cmd_rename "$@" ;;
    remove) cmd_remove "$@" ;;
    clean) cmd_clean "$@" ;;
    re-encrypt) cmd_re_encrypt "$@" ;;
    menu) cmd_menu "$@" ;;
    # 隐藏命令：给 shell 补全喂条目名
    __names) list_names ;;
    "") cmd_menu ;;
    -h | --help | help)
      usage
      exit 0
      ;;
    *)
      echo "未知命令: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
