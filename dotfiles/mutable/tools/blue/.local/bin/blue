# blue — blue 启动 wrapper：bluebox 把 blue pin 在 guile-3.0.9，与系统
# profile 已用 3.0.11 编译的字节码错配；借系统 guile -s 直跑脚本主体绕过
# （shebang 被当作注释跳过）。bluebox 升级后可整体删包。
# 拦截即覆写：首参恰为 update/gc 且包内 libexec/ 有对应增强脚本时分发；
# 缺失/不可执行则落回下方直通（原生行为即末行 exec，永不因增强缺位而坏）。
# 文档：docs/scripts/blue-wrapper.md（update/gc 机制见 docs/emergency-blue.md §8-9）

_blue_self="$(readlink -f "$0")"
_blue_dir="$(dirname "$_blue_self")"            # …/blue/.local/bin
_blue_libexec="$(dirname "$_blue_dir")/libexec" # …/blue/.local/libexec
case "${1:-}" in
  update | gc)
    if [ -x "$_blue_libexec/blue-$1" ]; then
      exec "$_blue_libexec/blue-$1" "${@:2}"
    fi
    ;;
esac

exec /run/current-system/profile/bin/guile --no-auto-compile \
  -e main -s "$HOME/.guix-home/profile/bin/blue" "$@"
