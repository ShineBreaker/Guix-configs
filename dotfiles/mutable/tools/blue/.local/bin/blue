# SPDX-License-Identifier: MIT

# blue — 供所有 shell（含 agent 的 bash）使用的 blue 启动 wrapper。
#
# 变通：bluebox 故意把 blue pin 在 guile-3.0（3.0.9，上游注释称
# 3.0.11 有 bug），而系统 profile 的 guix 模块已是 3.0.11 编译的字节码，
# 直接执行报 "incompatible bytecode version"。这里借系统 profile 的
# guile 3.0.11 直接以 -s 运行脚本主体（shebang 被当作注释跳过）。
# bluebox 升级 blue 的 guile 输入后可整体删除本包。
#
# 分发：首参恰为 update/gc 且包内 libexec/ 存在对应增强脚本（blue-update
# / blue-gc，机制见 docs/emergency-blue.md §8-9）时交给它处理；脚本缺失/
# 不可执行则落回下方直通逻辑（blue 原生行为），wrapper 永不因增强脚本
# 缺位而坏。其余参数一律原样直通。

_blue_self="$(readlink -f "$0")"
_blue_dir="$(dirname "$_blue_self")"              # …/blue/.local/bin
_blue_libexec="$(dirname "$_blue_dir")/libexec"  # …/blue/.local/libexec
case "${1:-}" in
  update | gc)
    if [ -x "$_blue_libexec/blue-$1" ]; then
      exec "$_blue_libexec/blue-$1" "${@:2}"
    fi
    ;;
esac

exec /run/current-system/profile/bin/guile --no-auto-compile \
     -e main -s "$HOME/.guix-home/profile/bin/blue" "$@"
